<html lang="en">
<%- include('./partials/head'); %>
<link rel="stylesheet" href="/static/css/particles.css">
<body class="d-flex flex-column h-100">
  <%- include('./partials/navbar', {active:'relay'}); %>
  <div class="background-theme flex-grow-1 d-flex flex-column">

    <div id="particles-js"></div>

    <section class="position-relative z-1 relay-hero">
      <div class="container px-4 px-lg-5 pt-4 pt-lg-5 pb-4">
        <div class="row align-items-center g-4 g-lg-5">
          <div class="col-lg-7">
            <div class="relay-hero-badge mb-3">
              <span class="relay-hero-dot"></span>
              <span><%= locals.relayAuthRequired ? "Authenticated" : "Public" %> Nostr relay · <%= locals.relaySupportedNipsCount %> NIPs supported</span>
            </div>
            <h1 class="text-white display-4 fw-bold mb-2 relay-hero-title"><%= locals.pageTitle || (locals.serverHost + " relay") %></h1>
            <p class="text-white-50 fs-4 fw-light mb-3"><%= locals.pageSubtitle || "Latest public notes from the community" %></p>
            <% if (locals.intro && locals.intro.trim()) { %>
            <p class="text-white-50 mb-3" style="max-width: 620px;"><%= locals.intro %></p>
            <% } %>
            <div class="relay-endpoint" role="button" tabindex="0"
                 data-value="wss://relay.<%= locals.serverHost %>"
                 title="Click to copy">
              <span class="relay-endpoint-label">Connect</span>
              <code class="relay-endpoint-url">wss://relay.<%= locals.serverHost %></code>
              <span class="btn btn-sm btn-outline-light pe-none"><i class="fa-solid fa-copy"></i></span>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="relay-stats-panel">
              <div class="relay-stat-primary">
                <div class="relay-stat-primary-value" id="relay-kpi-total"><%= (locals.relayTotalEvents || 0).toLocaleString() %></div>
                <div class="relay-stat-primary-label">events stored</div>
              </div>
              <div class="relay-stat-divider"></div>
              <div class="relay-stat-secondary">
                <div class="relay-stat-secondary-row">
                  <span class="relay-stat-secondary-value" id="relay-kpi-recent"><%= (locals.relayRecentEvents || 0).toLocaleString() %></span>
                  <span class="relay-stat-secondary-label">last hour</span>
                </div>
                <div class="relay-stat-live">
                  <span class="relay-kpi-dot"></span>
                  <span>live · updated every 15s</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="container-fluid px-0 relay-panel position-relative flex-grow-1">
      <div class="container relay-feed-container px-3 py-4">

        <div id="relay-feed" class="relay-feed">
          <% locals.lastRelayNotes.forEach(note => { %>
            <article class="relay-note"
                     data-id="<%= note.id %>"
                     data-pubkey="<%= note.pubkey %>"
                     data-event='<%= JSON.stringify(note).replace(/'/g, "&#39;") %>'
                     role="button"
                     tabindex="0">
              <div class="relay-note-header">
                <div class="relay-note-avatar" data-pubkey="<%= note.pubkey %>">
                  <span class="relay-note-avatar-fallback"><%= note.pubkey.slice(0, 2).toUpperCase() %></span>
                </div>
                <div class="relay-note-meta flex-grow-1 min-w-0">
                  <div class="relay-note-name" data-pubkey="<%= note.pubkey %>">
                    <code class="text-muted"><%= note.pubkey.slice(0, 12) %>…<%= note.pubkey.slice(-6) %></code>
                  </div>
                  <time class="relay-note-time text-muted"
                        datetime="<%= new Date(note.created_at * 1000).toISOString() %>"><%= new Date(note.created_at * 1000).toLocaleString('en', { year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', hour12:false }) %></time>
                </div>
                <a class="relay-note-action"
                   href="https://njump.me/<%= note.event_id %>"
                   target="_blank" rel="noopener noreferrer"
                   title="Open in njump"
                   onclick="event.stopPropagation();">
                  <i class="fa-solid fa-up-right-from-square"></i>
                </a>
              </div>
              <div class="relay-note-content"><%= note.content.toString().trim().substring(0, 360) %><%= note.content.toString().trim().length > 360 ? '…' : '' %></div>
            </article>
          <% }); %>
        </div>

        <div id="relay-feed-sentinel" aria-hidden="true"></div>
        <div id="relay-feed-loading" class="text-center text-muted small d-none my-3">
          <span class="spinner-border spinner-border-sm me-1"></span> Loading more…
        </div>
        <div id="relay-feed-end" class="text-center text-muted small d-none my-3">
          That's all from the last 30 days.
        </div>
        <% if (locals.lastRelayNotes.length === 0) { %>
        <div class="text-center text-muted my-5">
          <i class="fa-regular fa-comment-dots fs-1 d-block mb-3"></i>
          No public notes yet on this relay.
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('./partials/footer', {active:'relay'}); %>
  <%- include('./components/modals/message-modal', {"object":"firstUse"}); %>
  <%- include('./components/modals/event-modal'); %>
</body>

<style>
  /* --- Hero badge ------------------------------------------------------ */
  .relay-hero { overflow: hidden; }
  .relay-hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 12px;
    background: rgba(165, 117, 255, 0.15);
    border: 1px solid rgba(165, 117, 255, 0.35);
    border-radius: 999px;
    color: #e7d8ff;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 500;
  }
  .relay-hero-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #c8a3ff;
    box-shadow: 0 0 8px rgba(200, 163, 255, 0.9);
  }
  .relay-hero-title {
    background: linear-gradient(135deg, #fff 0%, #d7c0ff 60%, #ff9ee0 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #fff;
    letter-spacing: -1px;
    line-height: 1.05;
  }

  /* --- Stats panel (right column on lg+) ------------------------------- */
  .relay-stats-panel {
    background: linear-gradient(135deg, rgba(165, 117, 255, 0.12) 0%, rgba(255, 102, 178, 0.08) 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 26px 26px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    /* Soft ambient shadow, low opacity so the panel just lifts off the background
       without leaving a dark band underneath. */
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  .relay-stat-primary-value {
    color: #fff;
    font-size: clamp(2rem, 4.2vw, 3rem);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -1px;
    transition: color 0.4s ease;
  }
  .relay-stat-primary-value.relay-kpi-bumped { color: #c8a3ff; }
  .relay-stat-primary-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
  }
  .relay-stat-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.22), transparent);
    margin: 16px 0;
  }
  .relay-stat-secondary { display: flex; flex-direction: column; gap: 6px; }
  .relay-stat-secondary-row { display: flex; align-items: baseline; gap: 10px; }
  .relay-stat-secondary-value {
    color: #fff;
    font-size: 1.35rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition: color 0.4s ease;
  }
  .relay-stat-secondary-value.relay-kpi-bumped { color: #c8a3ff; }
  .relay-stat-secondary-label {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }
  .relay-stat-live {
    display: inline-flex; align-items: center; gap: 6px;
    color: #8fc99a;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .relay-kpi-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #8fc99a;
    box-shadow: 0 0 0 0 rgba(143, 201, 154, 0.45);
    animation: relay-pulse 1.8s infinite;
  }
  @keyframes relay-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(143, 201, 154, 0.45); }
    70%  { box-shadow: 0 0 0 8px rgba(143, 201, 154, 0); }
    100% { box-shadow: 0 0 0 0 rgba(143, 201, 154, 0); }
  }

  /* --- Endpoint copy chip --------------------------------------------- */
  .relay-endpoint {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    max-width: 100%;
  }
  .relay-endpoint:hover {
    border-color: rgba(200, 163, 255, 0.7);
    background: rgba(0, 0, 0, 0.45);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(165, 117, 255, 0.25);
  }
  .relay-endpoint-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: rgba(255, 255, 255, 0.6); flex-shrink: 0; }
  .relay-endpoint-url { color: #fff; font-size: 1rem; font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace; word-break: break-all; background: none; padding: 0; }

  /* --- Feed ------------------------------------------------------------ */
  .relay-feed-container { max-width: 820px; }
  .relay-feed { display: flex; flex-direction: column; gap: 14px; }

  .relay-note {
    background: var(--bs-body-bg, #fff);
    border: 1px solid rgba(128, 128, 128, 0.18);
    border-radius: 12px;
    padding: 16px 18px;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
    position: relative;
    animation: relay-card-in 0.4s ease both;
  }
  @keyframes relay-card-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  [data-bs-theme="dark"] .relay-note {
    background: #1c1f24;
    border-color: rgba(255, 255, 255, 0.08);
  }
  .relay-note:hover {
    border-color: rgba(165, 117, 255, 0.55);
    box-shadow: 0 8px 24px rgba(165, 117, 255, 0.12);
    transform: translateY(-2px);
  }

  .relay-note-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .relay-note-avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #a575ff, #6f4eaa);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-weight: 600;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 4px 12px rgba(165, 117, 255, 0.25);
  }
  .relay-note-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .relay-note-avatar-fallback { font-size: 1rem; letter-spacing: 0.5px; }

  .relay-note-meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .relay-note-name { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.95rem; }
  .relay-note-name code { font-size: 0.85rem; }
  .relay-note-time { font-size: 0.75rem; }

  .relay-note-action {
    color: var(--bs-secondary-color, #6c757d);
    padding: 6px 8px;
    border-radius: 6px;
    flex-shrink: 0;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .relay-note-action:hover { color: #a575ff; background: rgba(165, 117, 255, 0.12); }

  .relay-note-content {
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.55;
    margin: 0;
    font-size: 0.95rem;
  }
  .relay-note-content .relay-hashtag {
    color: #a575ff;
    font-weight: 500;
    text-decoration: none;
  }
  [data-bs-theme="light"] .relay-note-content .relay-hashtag { color: #7a4ed8; }

  .min-w-0 { min-width: 0; }

  @media (max-width: 991px) {
    .relay-stats-panel { padding: 22px 22px; margin-top: 8px; }
    .relay-hero-title { font-size: 2.4rem !important; }
  }
  @media (max-width: 575px) {
    .relay-stats-panel { padding: 18px 18px; }
    .relay-stat-primary-value { font-size: 2.6rem; }
    .relay-stat-secondary-value { font-size: 1.4rem; }
    .relay-endpoint { width: 100%; }
    .relay-endpoint-url { font-size: 0.85rem; }
  }
</style>

<script>
  (function() {
    // Hydration tasks for the relay feed: relative times, per-pubkey metadata (kind 0)
    // to replace the hex code with name + avatar, click-to-modal, and cursor-based
    // pagination via /api/v2/relay/notes?before=<id>.

    const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
    const timeUnits = [
      ['year',   60*60*24*365],
      ['month',  60*60*24*30],
      ['week',   60*60*24*7],
      ['day',    60*60*24],
      ['hour',   60*60],
      ['minute', 60],
      ['second', 1]
    ];

    function rel(iso) {
      if (!iso) return '';
      const diff = Math.round((new Date(iso).getTime() - Date.now()) / 1000);
      for (const [unit, sec] of timeUnits) {
        if (Math.abs(diff) >= sec || unit === 'second') {
          return rtf.format(Math.round(diff/sec), unit);
        }
      }
      return '';
    }

    function applyRelativeTimes(root) {
      (root || document).querySelectorAll('.relay-note-time[datetime]').forEach(el => {
        const iso = el.getAttribute('datetime');
        el.textContent = rel(iso);
      });
    }

    // Inline-highlight #hashtags in note content. Runs post-render so the SSR-served
    // cards and dynamically-appended ones both get the same treatment.
    function highlightHashtags(root) {
      (root || document).querySelectorAll('.relay-note-content').forEach(el => {
        if (el.dataset.hashHighlighted === '1') return;
        el.innerHTML = el.innerHTML.replace(/(^|\s)#([\p{L}\p{N}_][\p{L}\p{N}_-]{0,63})/gu, '$1<span class="relay-hashtag">#$2</span>');
        el.dataset.hashHighlighted = '1';
      });
    }

    function attachClickHandlers(root) {
      (root || document).querySelectorAll('.relay-note[data-event]').forEach(card => {
        if (card.dataset.bound === '1') return;
        const open = (e) => {
          if (e.target.closest('a, button')) return;
          try { window.openEventModal(JSON.parse(card.dataset.event)); }
          catch (err) { console.error('openEventModal failed', err); }
        };
        card.addEventListener('click', open);
        card.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(e); }
        });
        card.dataset.bound = '1';
      });
    }

    // Populate avatars + display names with metadata from the user's preferred relays.
    async function hydrateMetadata(root) {
      if (typeof subscribeRelays !== 'function') return;
      const scope = root || document;
      const pubkeys = Array.from(new Set(
        Array.from(scope.querySelectorAll('.relay-note[data-pubkey]')).map(el => el.dataset.pubkey).filter(Boolean)
      ));
      if (pubkeys.length === 0) return;
      try {
        const since = Math.floor(Date.now() / 1000) - (730 * 24 * 60 * 60);
        const events = await subscribeRelays(0, pubkeys, 'from', since);
        if (!Array.isArray(events)) return;
        const byPubkey = new Map();
        for (const ev of events) {
          if (!ev || !ev.pubkey) continue;
          // Keep the newest kind 0 per pubkey
          const prev = byPubkey.get(ev.pubkey);
          if (!prev || ev.created_at > prev.created_at) byPubkey.set(ev.pubkey, ev);
        }
        byPubkey.forEach((ev, pubkey) => {
          let meta;
          try { meta = JSON.parse(ev.content); } catch { return; }
          const displayName = meta.display_name || meta.name || null;
          const picture = meta.picture || null;

          scope.querySelectorAll(`.relay-note-name[data-pubkey="${pubkey}"]`).forEach(el => {
            if (displayName) el.innerHTML = `<span class="fw-semibold">${escapeHtml(displayName)}</span>`;
          });
          if (picture) {
            scope.querySelectorAll(`.relay-note-avatar[data-pubkey="${pubkey}"]`).forEach(el => {
              const safeUrl = picture.replace(/"/g, '&quot;');
              el.innerHTML = `<img loading="lazy" decoding="async" alt="" src="${safeUrl}" onerror="this.parentElement.innerHTML='<span class=\\'relay-note-avatar-fallback\\'>${pubkey.slice(0,2).toUpperCase()}</span>'">`;
            });
          }
        });
      } catch (err) {
        console.debug('relay feed metadata hydrate failed', err);
      }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    // Cursor pagination
    const feed = document.getElementById('relay-feed');
    const sentinel = document.getElementById('relay-feed-sentinel');
    const loadingEl = document.getElementById('relay-feed-loading');
    const endEl = document.getElementById('relay-feed-end');
    let loading = false;
    let exhausted = false;

    async function loadMore() {
      if (loading || exhausted) return;
      const last = feed.querySelector('.relay-note:last-of-type');
      if (!last) { exhausted = true; endEl.classList.remove('d-none'); return; }
      const beforeId = last.dataset.id;
      if (!beforeId) return;

      loading = true;
      loadingEl.classList.remove('d-none');
      try {
        const res = await fetch('/api/v2/relay/notes?before=' + encodeURIComponent(beforeId) + '&limit=30');
        const data = await res.json();
        const notes = (data && Array.isArray(data.notes)) ? data.notes : [];
        if (notes.length === 0) {
          exhausted = true;
          endEl.classList.remove('d-none');
          return;
        }
        const fragment = document.createDocumentFragment();
        notes.forEach(note => fragment.appendChild(renderNote(note)));
        feed.appendChild(fragment);
        applyRelativeTimes(feed);
        highlightHashtags(feed);
        attachClickHandlers(feed);
        hydrateMetadata(feed);
      } catch (err) {
        console.debug('loadMore failed', err);
      } finally {
        loading = false;
        loadingEl.classList.add('d-none');
      }
    }

    function renderNote(note) {
      const iso = new Date((note.created_at || 0) * 1000).toISOString();
      const content = String(note.content || '').trim();
      const truncated = content.length > 360 ? content.slice(0, 360) + '…' : content;
      const pubkey = String(note.pubkey || '');

      const article = document.createElement('article');
      article.className = 'relay-note';
      article.dataset.id = note.id;
      article.dataset.pubkey = pubkey;
      article.dataset.event = JSON.stringify(note);
      article.setAttribute('role', 'button');
      article.setAttribute('tabindex', '0');

      article.innerHTML = `
        <div class="relay-note-header">
          <div class="relay-note-avatar" data-pubkey="${pubkey}">
            <span class="relay-note-avatar-fallback">${pubkey.slice(0,2).toUpperCase()}</span>
          </div>
          <div class="relay-note-meta flex-grow-1 min-w-0">
            <div class="relay-note-name" data-pubkey="${pubkey}">
              <code class="text-muted">${pubkey.slice(0,12)}…${pubkey.slice(-6)}</code>
            </div>
            <time class="relay-note-time text-muted" datetime="${iso}"></time>
          </div>
          <a class="relay-note-action" href="https://njump.me/${note.event_id}" target="_blank" rel="noopener noreferrer" title="Open in njump" onclick="event.stopPropagation();">
            <i class="fa-solid fa-up-right-from-square"></i>
          </a>
        </div>
        <div class="relay-note-content">${escapeHtml(truncated)}</div>
      `;
      return article;
    }

    // Init
    applyRelativeTimes();
    highlightHashtags();
    attachClickHandlers();
    hydrateMetadata();

    document.querySelectorAll('.relay-endpoint').forEach(el => {
      const copy = () => { if (typeof copyToClipboard === 'function') copyToClipboard(el, el.dataset.value); };
      el.addEventListener('click', copy);
      el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); copy(); } });
    });

    // Live KPI polling. Refreshes the total/recent counts every 15s and flashes the
    // value briefly when it goes up so the page feels alive without burning bandwidth.
    const kpiTotalEl = document.getElementById('relay-kpi-total');
    const kpiRecentEl = document.getElementById('relay-kpi-recent');
    let prevTotal = Number((kpiTotalEl?.textContent || '0').replace(/[^0-9]/g, '')) || 0;
    let prevRecent = Number((kpiRecentEl?.textContent || '0').replace(/[^0-9]/g, '')) || 0;

    function bump(el) {
      if (!el) return;
      el.classList.add('relay-kpi-bumped');
      setTimeout(() => el.classList.remove('relay-kpi-bumped'), 800);
    }

    async function refreshStats() {
      if (document.hidden) return;
      try {
        const res = await fetch('/api/v2/relay/stats');
        const data = await res.json();
        if (!data || data.status !== 'success') return;
        const total = Number(data.total) || 0;
        const recent = Number(data.recent) || 0;
        if (kpiTotalEl) {
          if (total !== prevTotal) {
            kpiTotalEl.textContent = total.toLocaleString();
            if (total > prevTotal) bump(kpiTotalEl);
            prevTotal = total;
          }
        }
        if (kpiRecentEl) {
          if (recent !== prevRecent) {
            kpiRecentEl.textContent = recent.toLocaleString();
            if (recent > prevRecent) bump(kpiRecentEl);
            prevRecent = recent;
          }
        }
      } catch (err) {
        console.debug('relay stats refresh failed', err);
      }
    }
    setInterval(refreshStats, 15000);

    if (sentinel) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(e => e.isIntersecting)) loadMore();
      }, { rootMargin: '300px' });
      observer.observe(sentinel);
    }

    if ("<%= locals.firstUse %>" != undefined && "<%= locals.firstUse %>" != null && "<%= locals.firstUse %>" != "") {
      initMessageModal("#firstUse", "<%- locals.firstUse %>", "Welcome to your sovereignty");
    }
  })();
</script>
</html>
