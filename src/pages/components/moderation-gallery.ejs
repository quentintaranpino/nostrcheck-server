<%
// Dense thumbnail grid for moderating the hosted files backlog.
// locals:
//   triggerTabId : id of the tab button that reveals this view. When set, the
//                  first page is only fetched once that tab is shown, so the
//                  dashboard doesn't pay for it on every load. Empty = load now.
const modTriggerTabId = typeof triggerTabId !== 'undefined' ? triggerTabId : '';
%>
<div id="moderationGallery" class="mt-2">

  <h3 class="mt-4 mb-2 display-5 gradient-text">Moderation gallery</h3>
  <p class="mb-1">Thumbnail triage for the hosted files queue. Every card carries its own checked, NSFW, active and ban buttons; select several to apply one action to the lot.</p>
  <p class="small text-secondary">
    <strong>NSFW</strong> marks a file as reviewed and drops it from the public listings (gallery, home feed, search).
    It does <strong>not</strong> make the file private: anyone holding the direct URL can still download it.
    Deactivate or ban the file if you need it gone.
  </p>

  <div class="row g-2 align-items-end">
    <div class="col-12 col-md-3 col-lg-2">
      <label for="moderationGallery-status" class="form-label mb-1">Status</label>
      <select id="moderationGallery-status" class="form-select form-select-sm">
        <option value="pending" selected>Pending review</option>
        <option value="checked">Checked (NSFW included)</option>
        <option value="nsfw">NSFW (hidden from listings)</option>
        <option value="active">Active</option>
        <option value="inactive">Inactive</option>
        <option value="banned">Banned</option>
        <option value="all">All files</option>
      </select>
    </div>
    <div class="col-12 col-md-3 col-lg-2">
      <label for="moderationGallery-mimetype" class="form-label mb-1">Type</label>
      <select id="moderationGallery-mimetype" class="form-select form-select-sm">
        <option value="">All types</option>
      </select>
    </div>
    <div class="col-12 col-md-3 col-lg-3">
      <label for="moderationGallery-uploader" class="form-label mb-1">Top uploaders</label>
      <select id="moderationGallery-uploader" class="form-select form-select-sm">
        <option value="">All uploaders</option>
      </select>
    </div>
    <div class="col-12 col-md-3 col-lg-3">
      <label for="moderationGallery-pubkey" class="form-label mb-1">Pubkey (hex or npub)</label>
      <div class="input-group input-group-sm">
        <input id="moderationGallery-pubkey" type="text" class="form-control" placeholder="filter by pubkey" autocomplete="off">
        <button id="moderationGallery-pubkey-clear" class="btn btn-outline-secondary" type="button" title="Clear pubkey filter"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </div>
    <div class="col-6 col-md-2 col-lg-1">
      <label for="moderationGallery-size" class="form-label mb-1">Tiles</label>
      <%# Two fewer columns per row than the previous M (200px gave 6 on Jaume's
          screen, 300px gives 4). S and L keep the old 0.75 / 1 / 1.4 ratio, so
          the earlier density is still one click away. %>
      <select id="moderationGallery-size" class="form-select form-select-sm">
        <option value="225">S</option>
        <option value="300" selected>M</option>
        <option value="420">L</option>
      </select>
    </div>
    <div class="col-6 col-md-2 col-lg-1">
      <button id="moderationGallery-refresh" class="btn btn-secondary btn-sm w-100" type="button" title="Reload the queue"><i class="fa-solid fa-rotate"></i></button>
    </div>
  </div>

  <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
    <button id="moderationGallery-select-all" class="btn btn-outline-secondary btn-sm" type="button">Select all loaded</button>
    <button id="moderationGallery-select-none" class="btn btn-outline-secondary btn-sm" type="button">Clear selection</button>
    <%# Compaction is never automatic and never happens under the cursor: the
        operator asks for it when they are ready. %>
    <button id="moderationGallery-clear-spent" class="btn btn-outline-secondary btn-sm d-none" type="button" title="Remove the processed cards from the grid. Nothing moves until you press this.">Clear processed</button>
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="moderationGallery-autoplay" checked>
      <label class="form-check-label small" for="moderationGallery-autoplay" title="Plays the videos in view, muted and looping. Files over 15 MB never autoplay, open them in the viewer instead.">Autoplay video</label>
    </div>
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="moderationGallery-safetyblur">
      <label class="form-check-label small" for="moderationGallery-safetyblur" title="Blurs everything not reviewed yet. Hover a card to reveal it. Handy while sharing your screen.">Blur unreviewed</label>
    </div>
    <span id="moderationGallery-counter" class="text-secondary small ms-auto"></span>
  </div>

  <div id="moderationGallery-bulkbar" class="mod-bulkbar d-none">
    <span id="moderationGallery-bulkcount" class="fw-bold me-2"></span>
    <button id="moderationGallery-bulk-checked" class="btn btn-success btn-sm" type="button"><i class="fa-solid fa-check-circle me-1"></i>Mark checked</button>
    <button id="moderationGallery-bulk-nsfw" class="btn btn-sm mod-btn-nsfw" type="button" title="Checked + hidden from public listings. Still reachable by direct URL."><i class="fa-solid fa-mask me-1"></i>Mark NSFW</button>
    <button id="moderationGallery-bulk-enable" class="btn btn-primary btn-sm" type="button"><i class="fa-solid fa-eye me-1"></i>Activate</button>
    <button id="moderationGallery-bulk-disable" class="btn btn-warning btn-sm" type="button"><i class="fa-solid fa-eye-slash me-1"></i>Deactivate</button>
    <button id="moderationGallery-bulk-ban" class="btn btn-danger btn-sm" type="button"><i class="fa-solid fa-triangle-exclamation me-1"></i>Ban</button>
    <button id="moderationGallery-bulk-retry" class="btn btn-info btn-sm" type="button" title="Put pending or failed notifications for the selection back in the queue"><i class="fa-solid fa-paper-plane me-1"></i>Retry notification</button>
    <button id="moderationGallery-bulk-close" class="btn btn-outline-light btn-sm ms-1" type="button" title="Clear selection"><i class="fa-solid fa-xmark"></i></button>
  </div>

  <div id="moderationGallery-error" class="alert alert-danger mt-3 d-none" role="alert"></div>
  <div id="moderationGallery-empty" class="text-center py-5 fs-5 text-secondary d-none">Nothing to review with these filters</div>

  <div id="moderationGallery-grid" class="mod-grid mt-3" role="list"></div>

  <div class="d-flex justify-content-center align-items-center py-4 gap-3">
    <div id="moderationGallery-spinner" class="spinner-border text-secondary d-none" role="status"><span class="visually-hidden">Loading…</span></div>
    <button id="moderationGallery-more" class="btn btn-outline-secondary d-none" type="button">Load more</button>
  </div>
  <div id="moderationGallery-sentinel" aria-hidden="true"></div>
</div>

<%- include('./modals/confirm-modal', {"objectId":"moderationGallery"}); %>

<style>
  .mod-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--mod-tile, 300px), 1fr));
    gap: 6px;
  }
  .mod-tile {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 6px;
    background: #1a1a1a;
    /* The card selects; the zoom button opens it. */
    cursor: pointer;
    transition: opacity 0.25s ease;
  }
  .mod-tile .mod-btn-zoom { cursor: zoom-in; }
  .mod-tile.is-pending  { border-color: #ffc107; }
  .mod-tile.is-checked  { border-color: #198754; }
  .mod-tile.is-nsfw     { border-color: #d63384; }
  .mod-tile.is-banned   { border-color: #dc3545; }
  /* Selection has to be countable across a screenful, so it is not just an
     outline: a real tint sits over the thumbnail. An inset shadow would not do,
     the media element paints on top of it. The overlay stays under the badges and
     the action bar and ignores the pointer. */
  .mod-tile.is-selected { outline: 3px solid #a575ff; outline-offset: -3px; }
  .mod-tile.is-selected::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(165, 117, 255, 0.3);
    z-index: 3;
    pointer-events: none;
  }
  .mod-tile.is-selected .mod-check { transform: scale(1.15); }
  .mod-tile.is-leaving  { opacity: 0; }
  /* Busy dims, never blurs: a blur left behind by a hung request would hide the
     very thing the operator is judging. */
  .mod-tile.is-busy     { pointer-events: none; }
  .mod-tile.is-busy .mod-media { opacity: 0.45; }

  .mod-tile .mod-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 1;
  }
  .mod-tile img.mod-media { opacity: 0; transition: opacity 0.25s ease; }
  .mod-tile img.mod-media.is-loaded { opacity: 1; }

  /* The placeholder only exists while the image is in flight: the canvas is
     removed from the DOM on load, so no thumbnail can stay blurred for good. */
  .mod-tile canvas.mod-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* Opt-in safety blur, off by default: moderating means looking at the file. */
  .mod-grid.mod-safety-blur .mod-tile.is-pending .mod-media { filter: blur(14px); }
  .mod-grid.mod-safety-blur .mod-tile.is-pending:hover .mod-media { filter: none; }

  .mod-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px;
    text-align: center;
    color: #cfcfcf;
    background: #2b3035;
    position: relative;
    z-index: 1;
  }
  .mod-fallback i { font-size: 1.6rem; }
  .mod-fallback .mod-fallback-label {
    font-size: 0.68rem;
    line-height: 1.15;
    word-break: break-all;
    opacity: 0.9;
  }
  .mod-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.8rem;
    text-shadow: 0 0 6px rgba(0,0,0,0.8);
    z-index: 2;
    pointer-events: none;
  }
  /* Once the stream is running the play hint gets out of the way. */
  .mod-tile.is-playing .mod-play { display: none; }

  .mod-check {
    position: absolute;
    top: 4px;
    left: 4px;
    z-index: 5;
    margin: 0;
    cursor: pointer;
  }
  .mod-badges {
    position: absolute;
    top: 2px;
    right: 2px;
    display: flex;
    align-items: center;
    gap: 3px;
    z-index: 4;
    font-size: 0.7rem;
  }
  .mod-badges i {
    background: rgba(0,0,0,0.6);
    border-radius: 3px;
    padding: 2px 3px;
  }
  .mod-chip {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.4px;
    line-height: 1;
    padding: 3px 4px;
    border-radius: 3px;
    color: #fff;
  }
  .mod-chip-nsfw { background: #d63384; }
  .mod-chip-off  { background: #cc8a00; }
  .mod-chip-big  { background: #495057; }
  /* Notification state keeps its own language (envelopes, blue) so it never
     reads as a moderation flag. A failed delivery pulses: it means the operator
     thinks somebody was warned and nobody was. */
  .mod-chip-failed {
    background: #0d6efd;
    box-shadow: 0 0 0 2px rgba(13,110,253,0.45);
    animation: mod-notify-pulse 1.6s ease-in-out infinite;
  }
  .mod-badges i.mod-notify { background: rgba(0,0,0,0.6); }
  @keyframes mod-notify-pulse {
    0%, 100% { box-shadow: 0 0 0 2px rgba(13,110,253,0.15); }
    50%      { box-shadow: 0 0 0 4px rgba(13,110,253,0.65); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mod-chip-failed { animation: none; }
  }

  .mod-actions {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px;
    padding: 3px;
    background: rgba(0,0,0,0.55);
    z-index: 4;
  }
  /* Big enough to hit without aiming. Four buttons at 36px plus gaps fit inside
     the smallest tile (225px) with room to spare, and the bar stays an overlay so
     it only covers the bottom strip of the thumbnail. */
  .mod-actions .btn {
    --bs-btn-padding-y: 0.3rem;
    --bs-btn-padding-x: 0.5rem;
    --bs-btn-font-size: 0.8rem;
    min-width: 36px;
    min-height: 32px;
  }

  /* checked asks twice: it is the one button whose consequence (the file leaves
     the queue) is invisible until it is too late, and the only one with no
     friction of its own. Ban already demands a reason. */
  /* 52px keeps the armed button inside the smallest tile: 52 + 4x36 + gaps + the
     bar padding is 214px against the 221px of usable width at S, so the row never
     wraps mid-decision. */
  .mod-actions .mod-btn-checked.is-confirming {
    --bs-btn-font-size: 0.7rem;
    --bs-btn-padding-x: 0.35rem;
    background: #0a58ca;
    border-color: #0a58ca;
    color: #fff;
    min-width: 52px;
  }

  /* A processed card keeps its cell. Nothing below it moves, so the next click
     lands where the operator aimed. */
  .mod-tile.is-spent {
    border-color: rgba(128,128,128,0.35);
    cursor: default;
  }
  .mod-tile.is-spent .mod-media,
  .mod-tile.is-spent .mod-fallback,
  .mod-tile.is-spent .mod-play,
  .mod-tile.is-spent .mod-badges,
  .mod-tile.is-spent .mod-actions,
  .mod-tile.is-spent .mod-check { display: none; }

  .mod-spent {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px;
    text-align: center;
    background: rgba(33,37,41,0.92);
    color: #dee2e6;
    z-index: 7;
  }
  .mod-spent-what {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  .mod-spent-name {
    font-size: 0.62rem;
    opacity: 0.7;
    word-break: break-all;
    max-width: 100%;
  }
  .mod-btn-nsfw {
    background: #d63384;
    border-color: #d63384;
    color: #fff;
  }
  .mod-btn-nsfw:hover { background: #b02a6c; border-color: #b02a6c; color: #fff; }

  .mod-spin {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 6;
  }

  .mod-bulkbar {
    position: sticky;
    bottom: 10px;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: rgba(43,48,53,0.96);
    color: #fff;
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
  }
</style>

<script type="module">
  // blurhash@1.1.4 is ESM only. Same import the public gallery uses; when it
  // fails the tiles just keep their solid placeholder.
  try {
      const { decode } = await import('https://esm.sh/blurhash@1.1.4');
      window.blurhashDecode = decode;
      window.dispatchEvent(new Event('blurhash-ready'));
  } catch (e) {
      console.warn('blurhash lib failed to load', e);
  }
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {

    const triggerTabId = "<%= modTriggerTabId %>";

    // 'filesData' is the public alias of the mediafiles table, the same one the
    // hosted files table posts to /updaterecord with.
    const tableKey = 'filesData';
    const pageSize = 60;
    const batchSize = 200;

    // Video guardrails. The queue holds ~7k videos averaging 4.5 MB with a long
    // tail into the hundreds of MB, so autoplay is capped both ways: at most
    // maxConcurrentVideos streams at a time, and anything fatter than
    // autoplayMaxBytes never streams inside the grid at all.
    const maxConcurrentVideos = 6;
    const autoplayMaxBytes = 15 * 1024 * 1024;
    const storeAutoplay = 'moderationGalleryAutoplay';
    const storeSafetyBlur = 'moderationGallerySafetyBlur';

    const state = {
        status: 'pending',
        mimetype: '',
        pubkey: '',
        cursor: 0,          // last id received, the queue pages by id not offset
        total: 0,
        loading: false,
        exhausted: false,
        started: false,
        needFacets: true,
        autoplay: true,
        aborter: null,
        rows: new Map(),        // id -> row data
        selected: new Set(),    // ids
        spent: new Map(),       // id -> {field, previous} for the processed slots
        videosInView: new Set(),
        videosPlaying: new Set(),
        videoObserver: null,
        scrollScheduled: false,
    };

    const el = {
        grid: document.getElementById('moderationGallery-grid'),
        status: document.getElementById('moderationGallery-status'),
        mimetype: document.getElementById('moderationGallery-mimetype'),
        uploader: document.getElementById('moderationGallery-uploader'),
        pubkey: document.getElementById('moderationGallery-pubkey'),
        pubkeyClear: document.getElementById('moderationGallery-pubkey-clear'),
        size: document.getElementById('moderationGallery-size'),
        refresh: document.getElementById('moderationGallery-refresh'),
        selectAll: document.getElementById('moderationGallery-select-all'),
        selectNone: document.getElementById('moderationGallery-select-none'),
        clearSpent: document.getElementById('moderationGallery-clear-spent'),
        autoplay: document.getElementById('moderationGallery-autoplay'),
        safetyBlur: document.getElementById('moderationGallery-safetyblur'),
        counter: document.getElementById('moderationGallery-counter'),
        bulkbar: document.getElementById('moderationGallery-bulkbar'),
        bulkcount: document.getElementById('moderationGallery-bulkcount'),
        error: document.getElementById('moderationGallery-error'),
        empty: document.getElementById('moderationGallery-empty'),
        spinner: document.getElementById('moderationGallery-spinner'),
        more: document.getElementById('moderationGallery-more'),
        sentinel: document.getElementById('moderationGallery-sentinel'),
    };

    if (!el.grid) return;

    // ---------------------------------------------------------------- helpers

    const showError = (message) => {
        el.error.textContent = message;
        el.error.classList.remove('d-none');
    };

    const clearError = () => {
        el.error.textContent = '';
        el.error.classList.add('d-none');
    };

    const toast = (message, alertClass) => {
        if (typeof showMessage === 'function') showMessage(escapeHtml(message), alertClass);
    };

    const formatSize = (bytes) => {
        const n = Number(bytes);
        if (!Number.isFinite(n) || n <= 0) return '';
        const units = ['B', 'KB', 'MB', 'GB'];
        let i = 0;
        let v = n;
        while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
        return `${v.toFixed(v >= 100 || i === 0 ? 0 : 1)} ${units[i]}`;
    };

    const mediaKind = (mimetype) => {
        const mime = String(mimetype || '');
        if (mime.startsWith('image/')) return 'image';
        if (mime.startsWith('video/')) return 'video';
        if (mime.startsWith('audio/')) return 'audio';
        return 'other';
    };

    const fileUrl = (row) => `/api/v2/media/${encodeURIComponent(row.pubkey || '')}/${encodeURIComponent(row.filename || '')}`;

    const tileOf = (id) => el.grid.querySelector(`[data-id="${CSS.escape(String(id))}"]`);

    const isFlagOn = (value) => Number(value) === 1;

    // Its own column. Independent from visibility, which stays the uploader's.
    const isNsfw = (row) => isFlagOn(row.nsfw);

    // Delivery state of the notifiable events of this file, as reported by the
    // audit layer. null / absent means "no information", which is what an install
    // without the auditlog table gets, and also what an audit-only file gets.
    const notificationOf = (row) => (row.notification && row.notification.status) ? row.notification : null;
    const isRetryable = (row) => {
        const notification = notificationOf(row);
        return notification !== null && notification.status !== 'sent' && Number(notification.id) > 0;
    };

    // A row stops belonging to the current view when the action just taken
    // pushes it out of the status filter. Dropping the tile is the feedback:
    // the queue visibly shrinks as you work through it.
    // Mirrors mediaModerationWhere on the server, including its two overlaps: a
    // banned file is no longer pending, and "checked" still holds the nsfw ones
    // (the badge is what tells them apart).
    const matchesStatus = (row) => {
        switch (state.status) {
            case 'pending':  return !isFlagOn(row.checked) && !isFlagOn(row.banned);
            case 'checked':  return isFlagOn(row.checked);
            case 'nsfw':     return isNsfw(row);
            case 'active':   return isFlagOn(row.active);
            case 'inactive': return !isFlagOn(row.active);
            case 'banned':   return isFlagOn(row.banned);
            default:         return true;
        }
    };

    const paintBlurhash = (canvas, hash) => {
        canvas.dataset.bh = hash;
        if (typeof window.blurhashDecode !== 'function') return;
        try {
            const pixels = window.blurhashDecode(hash, 32, 32);
            const ctx = canvas.getContext('2d');
            const imgData = ctx.createImageData(32, 32);
            imgData.data.set(pixels);
            ctx.putImageData(imgData, 0, 0);
        } catch (e) {
            // Placeholder stays solid, nothing else to do.
        }
    };

    window.addEventListener('blurhash-ready', () => {
        el.grid.querySelectorAll('canvas.mod-placeholder[data-bh]').forEach(c => paintBlurhash(c, c.dataset.bh));
    });

    // ------------------------------------------------------------------ video

    const startVideo = (video) => {
        if (!video.isConnected) return;
        if (!video.getAttribute('src')) video.setAttribute('src', video.dataset.src || '');
        state.videosPlaying.add(video);
        video.closest('.mod-tile')?.classList.add('is-playing');
        const played = video.play();
        if (played && typeof played.catch === 'function') played.catch(() => {});
    };

    // Pausing is not enough, the browser keeps pulling the rest of the file.
    // Dropping the src and calling load() is what actually aborts the transfer
    // and releases what was buffered.
    const stopVideo = (video) => {
        state.videosPlaying.delete(video);
        video.closest('.mod-tile')?.classList.remove('is-playing');
        try {
            video.pause();
            if (video.getAttribute('src')) {
                video.removeAttribute('src');
                video.load();
            }
        } catch (e) {
            // Element already detached, nothing left to abort.
        }
    };

    const stopAllVideos = () => {
        for (const video of [...state.videosPlaying]) stopVideo(video);
        state.videosPlaying.clear();
    };

    // Of everything on screen, only the cards closest to the middle of the
    // viewport get to stream. The rest sit on their poster.
    const reconcileVideos = () => {

        if (!state.autoplay || document.hidden) {
            stopAllVideos();
            return;
        }

        // Tiles dropped mid-session can leave detached elements behind.
        for (const video of [...state.videosInView]) {
            if (!video.isConnected) state.videosInView.delete(video);
        }

        const centre = window.innerHeight / 2;
        const winners = new Set([...state.videosInView]
            .map(video => {
                const rect = video.getBoundingClientRect();
                return { video, distance: Math.abs(rect.top + (rect.height / 2) - centre) };
            })
            .sort((a, b) => a.distance - b.distance)
            .slice(0, maxConcurrentVideos)
            .map(item => item.video));

        for (const video of [...state.videosPlaying]) {
            if (!winners.has(video)) stopVideo(video);
        }
        for (const video of winners) {
            if (!state.videosPlaying.has(video)) startVideo(video);
        }
    };

    state.videoObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
            if (entry.isIntersecting) {
                state.videosInView.add(entry.target);
            } else {
                state.videosInView.delete(entry.target);
                stopVideo(entry.target);
            }
        }
        reconcileVideos();
    }, { threshold: 0.25 });

    // Scrolling through a screenful of videos doesn't change what intersects,
    // but it does change which ones are nearest the middle.
    window.addEventListener('scroll', () => {
        if (state.scrollScheduled) return;
        state.scrollScheduled = true;
        requestAnimationFrame(() => {
            state.scrollScheduled = false;
            reconcileVideos();
        });
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            stopAllVideos();
        } else {
            reconcileVideos();
        }
    });

    const releaseTileVideo = (tile) => {
        const video = tile.querySelector('video.mod-media');
        if (!video) return;
        state.videosInView.delete(video);
        stopVideo(video);
        state.videoObserver?.unobserve(video);
    };

    // ------------------------------------------------------------- tile build

    const applyTileState = (tile, row) => {
        const nsfw = isNsfw(row);
        tile.classList.toggle('is-banned', isFlagOn(row.banned));
        tile.classList.toggle('is-nsfw', !isFlagOn(row.banned) && nsfw);
        tile.classList.toggle('is-checked', !isFlagOn(row.banned) && !nsfw && isFlagOn(row.checked));
        tile.classList.toggle('is-pending', !isFlagOn(row.banned) && !isFlagOn(row.checked));
        tile.classList.toggle('is-selected', state.selected.has(row.id));

        const badges = tile.querySelector('.mod-badges');
        if (badges) {
            // Static markup only, every value here is a flag we computed.
            const marks = [];
            if (isFlagOn(row.banned)) marks.push('<i class="fa-solid fa-triangle-exclamation text-danger" title="Banned"></i>');
            if (nsfw) marks.push('<span class="mod-chip mod-chip-nsfw" title="Reviewed, kept out of every public listing. Still reachable by direct URL.">NSFW</span>');
            if (!nsfw && isFlagOn(row.checked)) marks.push('<i class="fa-solid fa-check-circle text-success" title="Checked"></i>');
            if (!isFlagOn(row.active)) marks.push('<span class="mod-chip mod-chip-off" title="Inactive: the server serves a not-found banner for this file">OFF</span>');
            // The uploader's own switch, now unrelated to nsfw.
            if (!isFlagOn(row.visibility)) marks.push('<i class="fa-solid fa-lock text-secondary" title="Hidden by the uploader (visibility = 0)"></i>');
            if (mediaKind(row.mimetype) === 'video' && Number(row.filesize) > autoplayMaxBytes) {
                marks.push('<span class="mod-chip mod-chip-big" title="Too big to preview in the grid, click to watch it in the viewer">BIG</span>');
            }
            // Notification state. Its own shape (an envelope) so it never reads
            // as one of the moderation flags, and the failed one shouts.
            const notification = notificationOf(row);
            if (notification !== null) {
                if (notification.status === 'sent') {
                    marks.push('<i class="fa-solid fa-envelope-circle-check text-info mod-notify" title="Notification sent"></i>');
                } else if (notification.status === 'pending') {
                    marks.push('<i class="fa-solid fa-envelope text-secondary mod-notify" title="Notification queued, not sent yet"></i>');
                } else if (notification.status === 'failed') {
                    marks.push('<span class="mod-chip mod-chip-failed" title="Notification FAILED: nobody was warned. Use the retry button on the card.">!MAIL</span>');
                }
            }
            badges.innerHTML = marks.join('');
        }

        const checkbox = tile.querySelector('.mod-check');
        if (checkbox) checkbox.checked = state.selected.has(row.id);

        const checkedButton = tile.querySelector('.mod-btn-checked');
        if (checkedButton) {
            checkedButton.classList.toggle('btn-success', !isFlagOn(row.checked));
            checkedButton.classList.toggle('btn-secondary', isFlagOn(row.checked));
            checkedButton.title = isFlagOn(row.checked) ? 'Unmark as checked' : 'Mark as checked';
        }

        const nsfwButton = tile.querySelector('.mod-btn-nsfw');
        if (nsfwButton) {
            nsfwButton.title = nsfw
                ? 'Undo NSFW: put the file back on the public listings'
                : 'Mark NSFW: checked + hidden from the public listings. Still reachable by direct URL.';
        }

        const activeButton = tile.querySelector('.mod-btn-active');
        if (activeButton) {
            activeButton.innerHTML = isFlagOn(row.active) ? '<i class="fa-solid fa-eye"></i>' : '<i class="fa-solid fa-eye-slash"></i>';
            activeButton.title = isFlagOn(row.active) ? 'Deactivate file' : 'Activate file';
        }

        // Retry only exists while there is something to retry.
        const retryButton = tile.querySelector('.mod-btn-retry');
        if (retryButton) {
            const notification = notificationOf(row);
            retryButton.classList.toggle('d-none', !isRetryable(row));
            retryButton.title = notification && notification.lasterror !== ''
                ? `Queue the notification again (${notification.attempts} attempt(s), last error: ${notification.lasterror})`
                : 'Queue the notification again';
        }

        tile.title = tileTooltip(row);
    };

    const tileTooltip = (row) => {
        const notification = notificationOf(row);
        const lines = [
            row.filename || '',
            `${row.mimetype || ''} · ${formatSize(row.filesize)}`,
            `${row.username ? row.username + ' · ' : ''}${row.pubkey || ''}`,
            row.date || '',
        ];
        if (notification !== null) {
            lines.push(`notification: ${notification.status}${notification.attempts ? ' after ' + notification.attempts + ' attempt(s)' : ''}`);
            if (notification.lasterror !== '') lines.push(`last error: ${notification.lasterror}`);
        }
        // A title property is plain text, never parsed as markup.
        return lines.filter(Boolean).join('\n');
    };

    const fallbackCard = (row, iconClass, extraLabel) => {
        const fallback = document.createElement('div');
        fallback.className = 'mod-fallback';
        const icon = document.createElement('i');
        icon.className = `fa-solid ${iconClass}`;
        fallback.appendChild(icon);
        const label = document.createElement('div');
        label.className = 'mod-fallback-label';
        // textContent: mimetype, dimensions and size all come from the database.
        label.textContent = String(row.mimetype || 'unknown');
        fallback.appendChild(label);
        const meta = document.createElement('div');
        meta.className = 'mod-fallback-label';
        meta.textContent = [row.dimensions, formatSize(row.filesize), extraLabel].filter(Boolean).join(' · ');
        fallback.appendChild(meta);
        return fallback;
    };

    const buildMedia = (row) => {
        const kind = mediaKind(row.mimetype);
        const fragment = document.createDocumentFragment();

        if (kind === 'image') {

            // Blurhash placeholder, and only while the image is in flight: it is
            // removed from the DOM on load so a thumbnail can never stay blurred.
            let placeholder = null;
            if (row.blurhash) {
                placeholder = document.createElement('canvas');
                placeholder.className = 'mod-placeholder';
                placeholder.width = 32;
                placeholder.height = 32;
                fragment.appendChild(placeholder);
                paintBlurhash(placeholder, row.blurhash);
            }

            const img = document.createElement('img');
            img.className = 'mod-media';
            img.loading = 'lazy';
            img.decoding = 'async';
            img.fetchPriority = 'low';
            img.alt = '';
            img.src = fileUrl(row);
            const reveal = () => {
                img.classList.add('is-loaded');
                placeholder?.remove();
            };
            if (img.complete && img.naturalWidth > 0) {
                reveal();
            } else {
                img.addEventListener('load', reveal, { once: true });
                // On failure the blurhash stays as the fallback: it is the only
                // hint left of what the file was.
                img.addEventListener('error', () => img.classList.add('is-loaded'), { once: true });
            }
            fragment.appendChild(img);
            return fragment;
        }

        if (kind === 'video') {

            // The long tail is brutal (the biggest file in the queue is ~950 MB).
            // Over the threshold the card stays static and the viewer is the only
            // way to watch it.
            if (Number(row.filesize) > autoplayMaxBytes) {
                fragment.appendChild(fallbackCard(row, 'fa-film', 'click to play'));
                return fragment;
            }

            const video = document.createElement('video');
            video.className = 'mod-media';
            video.muted = true;
            video.loop = true;
            video.playsInline = true;
            video.preload = 'none';
            video.setAttribute('poster', '/static/resources/loading-video.webp');
            // src is attached on demand by the observer, never up front.
            video.dataset.src = fileUrl(row);
            fragment.appendChild(video);

            const overlay = document.createElement('div');
            overlay.className = 'mod-play';
            overlay.innerHTML = '<i class="fa-solid fa-circle-play"></i>';
            fragment.appendChild(overlay);
            return fragment;
        }

        // Audio and everything else: icon plus metadata, the file itself only
        // opens in the viewer.
        const icons = { audio: 'fa-music', other: 'fa-file-lines' };
        fragment.appendChild(fallbackCard(row, icons[kind] || icons.other));
        return fragment;
    };

    const createTile = (row) => {

        const tile = document.createElement('div');
        tile.className = 'mod-tile';
        tile.setAttribute('role', 'listitem');
        tile.dataset.id = String(row.id);

        tile.appendChild(buildMedia(row));

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'form-check-input mod-check';
        checkbox.setAttribute('aria-label', 'Select file');
        tile.appendChild(checkbox);

        const badges = document.createElement('div');
        badges.className = 'mod-badges';
        tile.appendChild(badges);

        const actions = document.createElement('div');
        actions.className = 'mod-actions';

        const checkedButton = document.createElement('button');
        checkedButton.type = 'button';
        checkedButton.className = 'btn btn-success mod-btn-checked';
        checkedButton.innerHTML = '<i class="fa-solid fa-check"></i>';
        actions.appendChild(checkedButton);

        const nsfwButton = document.createElement('button');
        nsfwButton.type = 'button';
        nsfwButton.className = 'btn mod-btn-nsfw';
        nsfwButton.innerHTML = '<i class="fa-solid fa-mask"></i>';
        actions.appendChild(nsfwButton);

        const activeButton = document.createElement('button');
        activeButton.type = 'button';
        activeButton.className = 'btn btn-secondary mod-btn-active';
        actions.appendChild(activeButton);

        const banButton = document.createElement('button');
        banButton.type = 'button';
        banButton.className = 'btn btn-danger mod-btn-ban';
        banButton.title = 'Ban file';
        banButton.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
        actions.appendChild(banButton);

        // Always on the bar, never hover-only: a control that appears on hover
        // doesn't exist on a touch screen and gets found by accident on a mouse.
        const zoomButton = document.createElement('button');
        zoomButton.type = 'button';
        zoomButton.className = 'btn btn-dark mod-btn-zoom';
        zoomButton.title = 'Open the file in the viewer (moderate and step through with the keyboard)';
        zoomButton.innerHTML = '<i class="fa-solid fa-magnifying-glass-plus"></i>';
        actions.appendChild(zoomButton);

        const retryButton = document.createElement('button');
        retryButton.type = 'button';
        retryButton.className = 'btn btn-info mod-btn-retry d-none';
        retryButton.innerHTML = '<i class="fa-solid fa-paper-plane"></i>';
        actions.appendChild(retryButton);

        tile.appendChild(actions);

        applyTileState(tile, row);

        const video = tile.querySelector('video.mod-media');
        if (video) state.videoObserver?.observe(video);

        return tile;
    };

    // ------------------------------------------------------------- selection

    const refreshBulkbar = () => {
        const count = state.selected.size;
        el.bulkcount.textContent = `${count} selected`;
        el.bulkbar.classList.toggle('d-none', count === 0);
    };

    const refreshCounter = () => {
        const processed = state.spent.size;
        const loaded = state.rows.size - processed;
        const bucket = state.status === 'all' ? 'files' : state.status;
        el.counter.textContent = processed > 0
                                    ? `${loaded} loaded of ${state.total} ${bucket} · ${processed} processed`
                                    : `${loaded} loaded of ${state.total} ${bucket}`;
        el.clearSpent.classList.toggle('d-none', processed === 0);
        el.clearSpent.textContent = `Clear processed (${processed})`;
    };

    const setSelected = (id, selected) => {
        if (selected) {
            state.selected.add(id);
        } else {
            state.selected.delete(id);
        }
        const tile = tileOf(id);
        if (tile) {
            tile.classList.toggle('is-selected', selected);
            const checkbox = tile.querySelector('.mod-check');
            if (checkbox) checkbox.checked = selected;
        }
        refreshBulkbar();
    };

    // Anchor for Shift+click. Selecting a few hundred files one card at a time is
    // the difference between one gesture and two hundred.
    let lastSelectedId = null;

    const selectRange = (fromId, toId) => {
        const order = [...state.rows.keys()].filter(id => !isSpent(id));
        const from = order.indexOf(fromId);
        const to = order.indexOf(toId);
        if (from === -1 || to === -1) return;
        const [start, end] = from <= to ? [from, to] : [to, from];
        for (let i = start; i <= end; i++) setSelected(order[i], true);
        lastSelectedId = toId;
    };

    const clearSelection = () => {
        state.selected.clear();
        el.grid.querySelectorAll('.mod-tile.is-selected').forEach(tile => {
            tile.classList.remove('is-selected');
            const checkbox = tile.querySelector('.mod-check');
            if (checkbox) checkbox.checked = false;
        });
        refreshBulkbar();
    };

    // ---------------------------------------------------------------- loading

    const resetGrid = (needFacets) => {
        state.aborter?.abort();
        state.aborter = null;
        state.cursor = 0;
        state.total = 0;
        state.loading = false;
        state.exhausted = false;
        state.needFacets = needFacets === true;
        state.rows.clear();
        state.selected.clear();
        // Changing filter or reloading is the other moment the grid is allowed to
        // rebuild: the processed slots go with it.
        state.spent.clear();
        stopAllVideos();
        state.videosInView.clear();
        state.videoObserver?.disconnect();
        el.grid.innerHTML = '';
        el.empty.classList.add('d-none');
        el.more.classList.add('d-none');
        clearError();
        refreshBulkbar();
        refreshCounter();
    };

    const loadPage = async () => {

        if (state.loading || state.exhausted) return;
        state.loading = true;
        el.spinner.classList.remove('d-none');
        el.more.classList.add('d-none');

        state.aborter?.abort();
        state.aborter = new AbortController();

        const params = new URLSearchParams();
        params.set('status', state.status);
        params.set('limit', String(pageSize));
        if (state.cursor > 0) params.set('cursor', String(state.cursor));
        if (state.mimetype) params.set('mimetype', state.mimetype);
        if (state.pubkey) params.set('pubkey', state.pubkey);
        if (state.needFacets) params.set('facets', '1');

        let payload;
        try {
            // fetchJSON turns a proxy error page into a readable status instead of
            // a JSON parse error, and marks whether the server is unavailable or
            // the session is gone.
            payload = await fetchJSON(`/api/v2/admin/mediamoderation?${params}`, {
                method: 'GET',
                credentials: 'include',
                signal: state.aborter.signal,
            });
            if (!payload || payload.status !== 'success') {
                throw new Error(payload?.message || 'unexpected answer from the server');
            }
        } catch (err) {
            if (err.name === 'AbortError') return;
            console.error('moderation gallery - fetch failed', err);
            state.loading = false;
            el.spinner.classList.add('d-none');
            // Never reload or redirect on a server failure, only say what happened.
            const detail = err.serverUnavailable
                            ? `${err.message}. The queue is untouched, try again in a moment.`
                            : err.sessionLost
                                ? `${err.message}. Your session may have expired: open the dashboard again in another tab to check before reloading this one.`
                                : err.message;
            showError(`Could not load the moderation queue: ${detail}`);
            el.more.classList.toggle('d-none', state.rows.size === 0);
            return;
        }

        clearError();
        state.total = Number(payload.total) || 0;

        if (state.needFacets && payload.facets) {
            renderFacets(payload.facets);
            state.needFacets = false;
        }

        const rows = Array.isArray(payload.rows) ? payload.rows : [];
        const fragment = document.createDocumentFragment();
        for (const row of rows) {
            row.id = Number(row.id);
            // The cursor advances even for rows already on screen, otherwise a
            // duplicate would stall the paging.
            if (state.cursor === 0 || row.id < state.cursor) state.cursor = row.id;
            if (state.rows.has(row.id)) continue;
            state.rows.set(row.id, row);
            fragment.appendChild(createTile(row));
        }
        el.grid.appendChild(fragment);

        if (rows.length < pageSize) state.exhausted = true;

        state.loading = false;
        el.spinner.classList.add('d-none');
        el.more.classList.toggle('d-none', state.exhausted);
        el.empty.classList.toggle('d-none', state.rows.size > 0);
        refreshCounter();
        reconcileVideos();
    };

    const renderFacets = (facets) => {

        const currentMimetype = state.mimetype;
        el.mimetype.innerHTML = '';
        const allTypes = document.createElement('option');
        allTypes.value = '';
        allTypes.textContent = 'All types';
        el.mimetype.appendChild(allTypes);

        // Group shortcuts first, they are what an operator actually reaches for.
        for (const group of ['image/*', 'video/*', 'audio/*']) {
            const option = document.createElement('option');
            option.value = group;
            option.textContent = group;
            el.mimetype.appendChild(option);
        }

        for (const item of (facets.mimetypes || [])) {
            const option = document.createElement('option');
            option.value = String(item.mimetype || '');
            option.textContent = `${item.mimetype || 'unknown'} (${item.count})`;
            el.mimetype.appendChild(option);
        }
        el.mimetype.value = currentMimetype;
        if (el.mimetype.value !== currentMimetype) el.mimetype.value = '';

        el.uploader.innerHTML = '';
        const allUploaders = document.createElement('option');
        allUploaders.value = '';
        allUploaders.textContent = 'All uploaders';
        el.uploader.appendChild(allUploaders);
        for (const item of (facets.pubkeys || [])) {
            const option = document.createElement('option');
            option.value = String(item.pubkey || '');
            const who = item.username ? String(item.username) : String(item.pubkey || '').slice(0, 12) + '…';
            option.textContent = `${who} (${item.count})`;
            el.uploader.appendChild(option);
        }
        el.uploader.value = state.pubkey;
        if (el.uploader.value !== state.pubkey) el.uploader.value = '';
    };

    // ---------------------------------------------------------------- actions

    // What each action is called once it has been applied, and which fields it
    // touched (so undo can put them back).
    const spentLabels = {
        checked:  'marked checked',
        nsfw:     'marked NSFW',
        banned:   'banned',
        active:   'deactivated',
        visibility: 'visibility changed',
    };

    // A processed card does not leave the grid. It stays in its own cell showing
    // what was done and offering to undo it.
    //
    // Removing it would reflow every card after it, and on a screen where the
    // next click bans a file, a grid that shifts under the cursor is how the wrong
    // file gets banned. The slot is also a safety net: a misclick is visible right
    // where it happened instead of having to be hunted down in another filter.
    const markSpent = (id, field, previous) => {

        const row = state.rows.get(id);
        const tile = tileOf(id);
        if (!row || !tile) return;

        state.spent.set(id, { field, previous });
        state.selected.delete(id);
        releaseTileVideo(tile);

        tile.classList.add('is-spent');
        tile.querySelector('.mod-spent')?.remove();

        const panel = document.createElement('div');
        panel.className = 'mod-spent';

        const what = document.createElement('div');
        what.className = 'mod-spent-what';
        // Static vocabulary, not database text.
        what.textContent = spentLabels[field] || 'processed';
        panel.appendChild(what);

        const name = document.createElement('div');
        name.className = 'mod-spent-name';
        // textContent: the filename comes from the database.
        name.textContent = String(row.filename || '');
        panel.appendChild(name);

        const undo = document.createElement('button');
        undo.type = 'button';
        undo.className = 'btn btn-outline-light btn-sm mod-btn-undo';
        undo.innerHTML = '<i class="fa-solid fa-rotate-left me-1"></i>Undo';
        undo.title = 'Put this file back the way it was';
        panel.appendChild(undo);

        tile.appendChild(panel);
        refreshBulkbar();
        refreshCounter();
    };

    const isSpent = (id) => state.spent.has(id);

    // Restores the fields the action changed, in an order that survives the
    // nsfw rule: nsfw always forces checked = 1 on the way in, so checked is
    // restored last or it would be overwritten.
    const undoSpent = async (id) => {

        const record = state.spent.get(id);
        const row = state.rows.get(id);
        if (!record || !row) return;

        const previous = record.previous || {};
        const order = ['nsfw', 'banned', 'active', 'visibility', 'checked'];
        const steps = order.filter(field => previous[field] !== undefined);
        if (steps.length === 0) return;

        setBusy([id], true);
        let failed = false;
        let lastError = '';

        for (const field of steps) {
            const { processed, failed: rejected, lastError: error } = await postBulk(tableKey, [id], field, previous[field]);
            if (processed === 0 || rejected.has(id)) {
                failed = true;
                lastError = error;
                break;
            }
            row[field] = Number(previous[field]);
        }

        setBusy([id], false);

        if (failed) {
            toast(`Could not undo this file${lastError ? ': ' + lastError : ''}`, 'alert-danger');
            return;
        }

        // Back to a normal card, in the same cell it never left.
        state.spent.delete(id);
        const tile = tileOf(id);
        if (tile) {
            tile.classList.remove('is-spent');
            tile.querySelector('.mod-spent')?.remove();
            applyTileState(tile, row);
        }
        if (matchesStatus(row)) state.total++;
        refreshCounter();
        reconcileVideos();
        toast('File restored', 'alert-success');
    };

    // Only ever runs when the operator presses the button, so it can never move
    // the grid while they are aiming at something.
    const clearSpent = () => {
        for (const id of [...state.spent.keys()]) {
            const tile = tileOf(id);
            if (tile) {
                releaseTileVideo(tile);
                tile.remove();
            }
            state.spent.delete(id);
            state.rows.delete(id);
        }
        refreshCounter();
        reconcileVideos();
    };

    const setBusy = (ids, busy) => {
        for (const id of ids) {
            const tile = tileOf(id);
            if (!tile) continue;
            tile.classList.toggle('is-busy', busy);
            if (busy) {
                const spin = document.createElement('div');
                spin.className = 'mod-spin';
                spin.innerHTML = '<div class="spinner-border spinner-border-sm text-light" role="status"></div>';
                tile.appendChild(spin);
            } else {
                tile.querySelector('.mod-spin')?.remove();
            }
        }
    };

    // Sends one action to the bulk endpoint in chunks (it caps a batch at 500)
    // and reports back which ids the server refused.
    const postBulk = async (table, ids, field, value, reason) => {

        const failed = new Set();
        let processed = 0;
        let lastError = '';

        for (let i = 0; i < ids.length; i += batchSize) {
            const chunk = ids.slice(i, i + batchSize);
            try {
                const response = await fetch('/api/v2/admin/bulkmoderate', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ table, ids: chunk, field, value: String(value), reason: reason || '' }),
                });
                const payload = await response.json().catch(() => null);
                if (!response.ok || !payload || payload.status !== 'success') {
                    lastError = payload?.message || `HTTP ${response.status}`;
                    chunk.forEach(id => failed.add(id));
                    continue;
                }
                processed += Number(payload.processed) || 0;
                for (const id of (payload.failed || [])) failed.add(Number(id));
            } catch (err) {
                console.error('moderation gallery - action failed', err);
                lastError = err.message;
                chunk.forEach(id => failed.add(id));
            }
        }

        return { processed, failed, lastError };
    };

    // Applies a moderation action to media rows and only touches the local state
    // for the ids the server confirmed.
    const applyAction = async (ids, field, value, reason) => {

        if (ids.length === 0) return;

        // Snapshot before the write so a spent slot knows what to restore.
        const before = new Map();
        for (const id of ids) {
            const row = state.rows.get(id);
            if (!row) continue;
            before.set(id, field === 'nsfw'
                            ? { nsfw: Number(row.nsfw) || 0, checked: Number(row.checked) || 0 }
                            : { [field]: Number(row[field]) || 0 });
        }

        setBusy(ids, true);
        const { processed, failed, lastError } = await postBulk(tableKey, ids, field, value, reason);
        setBusy(ids, false);

        for (const id of ids) {
            if (failed.has(id)) continue;
            const row = state.rows.get(id);
            if (!row) continue;
            if (field === 'nsfw') {
                // The same pair the server wrote in a single UPDATE. visibility
                // is not part of it any more.
                row.nsfw = Number(value);
                row.checked = 1;
            } else if (field === 'banned') {
                row.banned = Number(value);
            } else {
                row[field] = Number(value);
            }
            if (!matchesStatus(row)) {
                if (state.total > 0) state.total--;
                markSpent(id, field, before.get(id));
                continue;
            }
            const tile = tileOf(id);
            if (tile) applyTileState(tile, row);
        }

        refreshBulkbar();
        refreshCounter();
        reconcileVideos();

        if (failed.size > 0) {
            toast(`${failed.size} file(s) could not be updated${lastError ? ': ' + lastError : ''}`, 'alert-danger');
        }
        if (processed > 0) {
            toast(`${processed} file(s) updated`, 'alert-success');
        }
    };

    const confirmAction = async (ids, actionText, askReason) => {
        if (typeof initConfirmModal !== 'function') return { result: true, value: '' };
        return await initConfirmModal('#moderationGallery', ids, actionText, 'file', askReason ? '' : null, askReason === true);
    };

    // Returns whether the ban was actually applied, so the viewer can sync its own
    // switches when the ban was triggered from inside it.
    const banFiles = async (ids) => {
        if (ids.length === 0) return false;
        const modal = await confirmAction(ids, 'ban', true);
        if (modal.result !== true) return false;
        const reason = (modal.value || '').trim();
        if (reason === '') {
            toast('A ban needs a reason', 'alert-warning');
            return false;
        }
        await applyAction(ids, 'banned', 1, reason);
        return true;
    };

    // Puts the notice of each file back to pending so the sweep takes it again.
    // Writes to auditlog, not to mediafiles, so the ids on the wire are audit row
    // ids and not file ids.
    const retryNotifications = async (mediaIds) => {

        const targets = mediaIds.map(id => state.rows.get(id)).filter(row => row && isRetryable(row));
        if (targets.length === 0) {
            toast('Nothing to retry: no pending or failed notification here', 'alert-warning');
            return;
        }

        const tileIds = targets.map(row => row.id);
        setBusy(tileIds, true);
        const { processed, failed, lastError } = await postBulk('auditlogData', targets.map(row => Number(row.notification.id)), 'status', 'pending');
        setBusy(tileIds, false);

        for (const row of targets) {
            if (failed.has(Number(row.notification.id))) continue;
            row.notification.status = 'pending';
            const tile = tileOf(row.id);
            if (tile) applyTileState(tile, row);
        }

        if (failed.size > 0) toast(`${failed.size} notification(s) could not be queued${lastError ? ': ' + lastError : ''}`, 'alert-danger');
        if (processed > 0) toast(`${processed} notification(s) back in the queue`, 'alert-success');
    };

    // ----------------------------------------------------------------- events

    // The confirmation lives on the button itself. It reverts on its own so an
    // armed button never waits around to be pressed by accident later, and only
    // one is ever armed at a time.
    const checkedConfirmMs = 3000;
    let armedChecked = null;
    let armedCheckedTimer = null;

    const disarmCheckedConfirm = (button) => {
        if (!button) return;
        clearTimeout(armedCheckedTimer);
        button.dataset.confirming = '0';
        button.classList.remove('is-confirming');
        button.innerHTML = '<i class="fa-solid fa-check"></i>';
        if (armedChecked === button) armedChecked = null;
    };

    const armCheckedConfirm = (button) => {
        if (armedChecked && armedChecked !== button) disarmCheckedConfirm(armedChecked);
        armedChecked = button;
        button.dataset.confirming = '1';
        button.classList.add('is-confirming');
        button.textContent = 'sure?';
        clearTimeout(armedCheckedTimer);
        armedCheckedTimer = setTimeout(() => disarmCheckedConfirm(button), checkedConfirmMs);
    };

    el.grid.addEventListener('click', async (event) => {

        const tile = event.target.closest('.mod-tile');
        if (!tile) return;
        const id = Number(tile.dataset.id);
        const row = state.rows.get(id);
        if (!row) return;

        if (event.target.closest('.mod-btn-undo')) {
            await undoSpent(id);
            return;
        }

        // A processed slot is inert apart from its undo button.
        if (isSpent(id)) return;

        // The checkbox stays as an indicator and still works as a control; with
        // the whole card selectable it is no longer the only place to click.
        if (event.target.closest('.mod-check')) {
            setSelected(id, event.target.checked);
            lastSelectedId = id;
            return;
        }

        const checkedButton = event.target.closest('.mod-btn-checked');
        if (checkedButton) {
            // Two presses, no dialog. With a six figure queue a confirmation
            // modal per file would make the screen unusable, so the button turns
            // into its own confirmation and gives up after a few seconds. The
            // other three keep a single press: ban already demands a reason, and
            // active and NSFW are visible and reversible in place.
            if (checkedButton.dataset.confirming !== '1') {
                armCheckedConfirm(checkedButton);
                return;
            }
            disarmCheckedConfirm(checkedButton);
            await applyAction([id], 'checked', isFlagOn(row.checked) ? 0 : 1);
            return;
        }

        if (event.target.closest('.mod-btn-nsfw')) {
            await applyAction([id], 'nsfw', isNsfw(row) ? 0 : 1);
            return;
        }

        if (event.target.closest('.mod-btn-active')) {
            await applyAction([id], 'active', isFlagOn(row.active) ? 0 : 1);
            return;
        }

        if (event.target.closest('.mod-btn-ban')) {
            await banFiles([id]);
            return;
        }

        if (event.target.closest('.mod-btn-retry')) {
            await retryNotifications([id]);
            return;
        }

        // Tile body: selection. It is the constant gesture in batch triage, so it
        // gets the whole surface; opening the viewer is the occasional one and has
        // its own button.
        if (!event.target.closest('.mod-btn-zoom')) {
            if (event.shiftKey && lastSelectedId !== null && lastSelectedId !== id) {
                selectRange(lastSelectedId, id);
                return;
            }
            setSelected(id, !state.selected.has(id));
            lastSelectedId = id;
            return;
        }

        // Zoom: the shared viewer with the same four controls and the same
        // shortcuts as the Hosted files triage, so looking closer never means
        // closing the popup to act. Arrows walk the grid in the order it is
        // filtered, and every change lands back on the card behind.
        if (typeof initMediaModal === 'function') {
            stopAllVideos();
            const order = [...state.rows.keys()].filter(rowId => !isSpent(rowId));
            const rows = order.map(rowId => state.rows.get(rowId));
            await initMediaModal(`${row.pubkey}/${row.filename}`, row.checked, row.visibility, true, row, {
                rows: rows,
                index: Math.max(order.indexOf(id), 0),
                // Pulls the next page through the grid itself, so the modal and the
                // grid never walk different lists.
                loadMore: async () => {
                    const knownBefore = state.rows.size;
                    await loadPage();
                    if (state.rows.size === knownBefore) return [];
                    return [...state.rows.keys()].slice(knownBefore).map(rowId => state.rows.get(rowId));
                },
                // One behaviour, two entry points: a change made inside the popup
                // leaves exactly the same informative slot as its card button.
                onPersist: (changedRow, field, value, previous) => {
                    applyModalChange(Number(changedRow.id), field, value, previous);
                },
                onBan: async (targetRow) => {
                    const banned = await banFiles([Number(targetRow.id)]);
                    return banned === true;
                },
            });
            reconcileVideos();
        }
    });

    // Applies to the grid what the viewer just wrote, using the same rules the
    // card buttons use.
    const applyModalChange = (id, field, value, previous) => {

        const row = state.rows.get(id);
        if (!row) return;

        if (field === 'nsfw') {
            row.nsfw = Number(value);
            row.checked = 1;
        } else if (field === 'banned') {
            row.banned = Number(value);
        } else {
            row[field] = Number(value);
        }

        if (isSpent(id)) {
            // Already processed and being changed again from the viewer: keep the
            // slot, just retitle it.
            markSpent(id, field, state.spent.get(id).previous);
            return;
        }

        if (!matchesStatus(row)) {
            if (state.total > 0) state.total--;
            markSpent(id, field, previous);
            return;
        }

        const tile = tileOf(id);
        if (tile) applyTileState(tile, row);
        refreshCounter();
    };

    el.status.addEventListener('change', () => {
        state.status = el.status.value;
        state.mimetype = '';
        resetGrid(true);
        loadPage();
    });

    el.mimetype.addEventListener('change', () => {
        state.mimetype = el.mimetype.value;
        resetGrid(false);
        loadPage();
    });

    el.uploader.addEventListener('change', () => {
        state.pubkey = el.uploader.value;
        el.pubkey.value = state.pubkey;
        resetGrid(false);
        loadPage();
    });

    let pubkeyTimer = null;
    el.pubkey.addEventListener('input', () => {
        clearTimeout(pubkeyTimer);
        pubkeyTimer = setTimeout(() => {
            const value = el.pubkey.value.trim();
            if (value !== '' && !/^[a-f0-9]{64}$/i.test(value) && !value.startsWith('npub')) {
                showError('Pubkey must be 64 hex chars or an npub');
                return;
            }
            clearError();
            state.pubkey = value;
            el.uploader.value = el.uploader.querySelector(`option[value="${CSS.escape(value)}"]`) ? value : '';
            resetGrid(false);
            loadPage();
        }, 400);
    });

    el.pubkeyClear.addEventListener('click', () => {
        el.pubkey.value = '';
        el.uploader.value = '';
        state.pubkey = '';
        clearError();
        resetGrid(false);
        loadPage();
    });

    el.size.addEventListener('change', () => {
        el.grid.style.setProperty('--mod-tile', `${el.size.value}px`);
        reconcileVideos();
    });

    el.refresh.addEventListener('click', () => {
        resetGrid(true);
        loadPage();
    });

    el.more.addEventListener('click', () => loadPage());

    el.autoplay.addEventListener('change', () => {
        state.autoplay = el.autoplay.checked;
        try { localStorage.setItem(storeAutoplay, state.autoplay ? '1' : '0'); } catch (e) { /* storage blocked */ }
        reconcileVideos();
    });

    el.safetyBlur.addEventListener('change', () => {
        el.grid.classList.toggle('mod-safety-blur', el.safetyBlur.checked);
        try { localStorage.setItem(storeSafetyBlur, el.safetyBlur.checked ? '1' : '0'); } catch (e) { /* storage blocked */ }
    });

    el.selectAll.addEventListener('click', () => {
        for (const id of state.rows.keys()) state.selected.add(id);
        el.grid.querySelectorAll('.mod-tile').forEach(tile => {
            tile.classList.add('is-selected');
            const checkbox = tile.querySelector('.mod-check');
            if (checkbox) checkbox.checked = true;
        });
        refreshBulkbar();
    });

    el.selectNone.addEventListener('click', clearSelection);
    el.clearSpent.addEventListener('click', clearSpent);
    document.getElementById('moderationGallery-bulk-close').addEventListener('click', clearSelection);

    document.getElementById('moderationGallery-bulk-checked').addEventListener('click', async () => {
        await applyAction([...state.selected], 'checked', 1);
    });

    document.getElementById('moderationGallery-bulk-nsfw').addEventListener('click', async () => {
        await applyAction([...state.selected], 'nsfw', 1);
    });

    document.getElementById('moderationGallery-bulk-enable').addEventListener('click', async () => {
        const ids = [...state.selected];
        const modal = await confirmAction(ids, 'activate', false);
        if (modal.result !== true) return;
        await applyAction(ids, 'active', 1);
    });

    document.getElementById('moderationGallery-bulk-disable').addEventListener('click', async () => {
        const ids = [...state.selected];
        const modal = await confirmAction(ids, 'disable', false);
        if (modal.result !== true) return;
        await applyAction(ids, 'active', 0);
    });

    document.getElementById('moderationGallery-bulk-ban').addEventListener('click', async () => {
        await banFiles([...state.selected]);
    });

    document.getElementById('moderationGallery-bulk-retry').addEventListener('click', async () => {
        await retryNotifications([...state.selected]);
    });

    // Incremental scroll. The button next to it is the fallback for when the
    // grid lives inside a scrolling container the observer can't see.
    if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
            if (!state.started) return;
            if (entries.some(entry => entry.isIntersecting)) loadPage();
        }, { rootMargin: '400px' }).observe(el.sentinel);
    }

    const restorePreferences = () => {
        let autoplayPref = null;
        let blurPref = null;
        try {
            autoplayPref = localStorage.getItem(storeAutoplay);
            blurPref = localStorage.getItem(storeSafetyBlur);
        } catch (e) {
            // Storage blocked, keep the defaults.
        }
        state.autoplay = autoplayPref === null ? true : autoplayPref === '1';
        el.autoplay.checked = state.autoplay;
        const safetyBlur = blurPref === '1';
        el.safetyBlur.checked = safetyBlur;
        el.grid.classList.toggle('mod-safety-blur', safetyBlur);
    };

    const start = () => {
        if (state.started) return;
        state.started = true;
        el.grid.style.setProperty('--mod-tile', `${el.size.value}px`);
        restorePreferences();
        loadPage();
    };

    if (triggerTabId !== '') {
        const tabButton = document.getElementById(triggerTabId);
        if (tabButton) {
            tabButton.addEventListener('shown.bs.tab', start);
            // Leaving the tab hides the grid, nothing should keep streaming.
            tabButton.addEventListener('hide.bs.tab', stopAllVideos);
            if (tabButton.classList.contains('active')) start();
        } else {
            start();
        }
    } else {
        start();
    }

});
</script>
