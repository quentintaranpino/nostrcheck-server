  ['active'           , '30' , 'formatCheckbox', 'enabled   show text-center              '],
  ['checked'          , '30' , 'formatCheckbox', 'enabled   show text-center              '],
  ['banned'           , ''   , 'formatCheckbox', 'disabled  hide                          '],
  ['ip'               , '30' , ''              , 'disabled  show text-center              '],
  ['firstseen'        ,'200' , ''              , 'disabled  show text-center              '],
  ['lastseen'         ,'200' , ''              , 'disabled  show text-center              '],
  ['reqcount'         ,''    , ''              , 'disabled  show text-center              '],
  ['infractions'      ,''    , ''              , 'enabled   show text-center              '],
  ['comments'         ,''    , ''              , 'enabled   show mobile-hide              '],
];
%>
