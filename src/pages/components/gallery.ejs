<% if (privateGallery) { %>
    <div id="gallery-view" class="d-flex justify-content-start align-items-center p-2">
        <span class="me-2 lead fs-6">Select view</span>
            <div id="viewSelector" class="btn-group">
                <button type="button" class="btn btn-secondary active" data-view="list" id="listView">
                    <i class="fas fa-list"></i>
                </button>
                <button type="button" class="btn btn-secondary" data-view="masonry" id="galleryView">
                    <i class="fas fa-images"></i>
                </button>
            </div>
    </div>

    <div id="list-container" class="g-2 p-2 pt-0 <%= privateGallery ? '' : 'visually-hidden' %>">
        <table id="fileTable"></table>
    </div>
<% } %>

<div id="gallery-wrapper" class="gallery-wrapper <%= privateGallery ? 'visually-hidden' : '' %>">
    <div id="gallery-grid" class="gallery-grid" role="list"></div>
</div>
<div id="no-media" class="visually-hidden text-center py-5 fs-4"><p>No media files found</p></div>
<div id="sentinel-end" aria-hidden="true"></div>
<%- !privateGallery ? include('./loading', {objectId: 'gallery-list', dataName: 'Files'}) : '' %>

<style>
    /* Wrapper holds the full virtual height. The grid itself is positioned
       absolutely inside and only contains tiles in the visible window. */
    .gallery-wrapper {
        position: relative;
        width: 100%;
        padding: 4px;
    }
    .gallery-grid {
        position: absolute;
        left: 4px;
        right: 4px;
        display: grid;
        grid-template-columns: repeat(var(--gallery-cols, 5), 1fr);
        gap: 4px;
        will-change: transform;
    }

    .gallery-tile {
        position: relative;
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 6px;
        background: #1a1a1a;
        cursor: pointer;
    }
    .gallery-tile img,
    .gallery-tile video,
    .gallery-tile canvas {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .gallery-tile img,
    .gallery-tile video {
        position: relative;
        z-index: 1;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .gallery-tile img.is-loaded,
    .gallery-tile video.is-loaded { opacity: 1; }
    .gallery-tile .blur-placeholder {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        transition: opacity 0.3s ease;
    }
    .gallery-tile:has(img.is-loaded) .blur-placeholder,
    .gallery-tile:has(video.is-loaded) .blur-placeholder { opacity: 0; pointer-events: none; }
    .gallery-tile .file-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #333;
        font-size: 1.4rem;
        text-align: center;
    }
    .gallery-tile .audio-tile {
        background: url('/static/resources/loading-music.webp') center / cover no-repeat;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        padding: 8px;
        /* Centred (not bottom) so the transport bar never sits under the hover
           button overlay. The wrapper ignores pointer events so the tile click
           and the action buttons still work; only the <audio> itself catches
           clicks, which is what lets play/seek work instead of opening the modal. */
        pointer-events: none;
    }
    .gallery-tile .audio-tile audio { width: 100%; pointer-events: auto; }
    .gallery-tile .btn-container {
        position: absolute;
        bottom: 4px;
        left: 4px;
        right: 4px;
        padding: 4px;
        background: rgba(0,0,0,0.45);
        border-radius: 5px;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 5;
    }
    .gallery-tile:hover .btn-container,
    .gallery-tile:focus-within .btn-container { opacity: 1; transform: translateY(0); }
    .gallery-tile .btn-container .btn { min-width: 36px; }
</style>

<script type="module">
    // blurhash@1.1.4 is ESM-only; import via esm.sh and signal on ready.
    try {
        const { decode } = await import('https://esm.sh/blurhash@1.1.4');
        window.blurhashDecode = decode;
        window.dispatchEvent(new Event('blurhash-ready'));
    } catch (e) {
        console.warn('blurhash lib failed to load', e);
    }
</script>
<script>
const privateGallery = <%= privateGallery %>;
const pubkey = "<%= pubkey %>";

// Virtual scroll state. The wrapper holds the full virtual height, the grid
// absolute-positioned inside renders only the window of tiles around the
// viewport. Tiles outside that window are not in the DOM at all — that's how
// we scale to 100k+ items without choking the browser.
const galleryState = {
    aborter: null,
    cursor: null,
    pageSize: 60,
    loading: false,
    exhausted: false,
    videoObserver: null,
    items: [],                       // ALL fetched items (data only, no DOM)
    tileSize: 180,                   // px, computed from container width
    columnsCount: 5,                 // computed from container width
    bufferRows: 3,
    renderedRange: { start: -1, end: -1 },
    scrollScheduled: false,
    resizeTimer: null,
    fileMasonryId: 0,
};

let fileTableId = 0;

document.addEventListener('DOMContentLoaded', () => {

    if (privateGallery) {
        $('#fileTable').bootstrapTable({
            columns: [
                { field: 'id', title: 'ID', class: 'text-center', sortable: true },
                { field: 'sha256', title: 'Filename', formatter: filenameFormatter, class: 'text-center', sortable: true },
                { field: 'm', title: 'Type', class: 'text-center', sortable: true },
                { field: 'url', title: 'Url', formatter: filenameFormatter, class: 'text-center d-none', sortable: true },
                { field: 'size', title: 'Size', class: 'text-center', sortable: true },
                { field: 'dim', title: 'Dimensions', class: 'text-center', sortable: true, visible: false },
                { field: 'date', title: 'Date', class: 'text-center', sortable: true, sorter: dateSorter },
                { field: 'payment_request', title: 'Payment Request', class: 'text-center', sortable: true, visible: false },
                { field: 'actions', title: 'Actions', formatter: actionsFormatter, class: 'text-center', sortable: false },
                { field: 'visibility', title: 'Visibility', class: 'text-center', visible: false },
                { field: 'auth', visible: false }
            ],
            idField: 'id',
            uniqueId: 'id',
            url: `/api/v2/media/list/${pubkey}`,
            ajax: function (params) { fetchTabledata(params) },
            data: [],
            search: true,
            searchAlign: 'left',
            mobileResponsive: true,
            minWidth: 1024,
            sortable: true,
            pagination: true,
            sidePagination: 'client',
            pageSize: 10,
            showColumns: true,
            detailView: true,
            detailFormatter: detailFormatter,
        });
    }

    // Single shared observer for ALL video tiles. Lazy-attaches src on first
    // intersection and pause/play based on viewport — same pattern as before
    // but adapted to virtual scroll: tiles in the window register themselves
    // and unregister when they're removed (via disconnect on rebuild).
    galleryState.videoObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
            const video = entry.target;
            if (entry.isIntersecting) {
                if (!video.src && video.dataset.src) video.src = video.dataset.src;
                video.play().catch(() => {});
            } else {
                video.pause();
            }
        }
    }, { rootMargin: '200px', threshold: 0.1 });

    document.getElementById('viewSelector')?.addEventListener('click', (event) => {
        const btn = event.target.closest('.btn');
        if (!btn) return;
        const view = btn.getAttribute('data-view');
        const masonryView = document.getElementById('gallery-wrapper');
        const listView = document.getElementById('list-container');
        document.querySelectorAll('#viewSelector .btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (view === 'masonry') {
            masonryView.classList.remove('visually-hidden');
            listView.classList.add('visually-hidden');
            resetGallery();
            initVirtualScroll();
        } else {
            masonryView.classList.add('visually-hidden');
            listView.classList.remove('visually-hidden');
            document.getElementById('gallery-list-loading')?.remove();
            galleryState.aborter?.abort();
        }
    });

    if (!privateGallery) {
        initVirtualScroll();
    }

    // Tile-level click → open the file details modal. Action buttons stop
    // propagation, so they keep their own behaviour.
    $(document).on('click', '.gallery-tile', function(event) {
        if (event.target.closest('.btn-container')) return;
        // Clicks on the inline audio player drive play/seek, not the modal.
        if (event.target.closest('.audio-tile')) return;
        event.preventDefault();
        const url = this.dataset.url;
        const visibility = this.dataset.visibility;
        if (!url) return;
        const filename = url.substring(url.lastIndexOf('/') + 1);
        const fileInfo = this._fileInfo || null;
        initMediaModal(filename, undefined, visibility, false, fileInfo);
    });

    $(document).on('click', '.btn-view', function(event) {
        event.stopPropagation();
        window.open($(this).data('url'), '_blank');
    });

    $(document).on('click', '.btn-info-action', function(event) {
        event.stopPropagation();
        event.preventDefault();
        const url = $(this).data('url') || '';
        const visibility = $(this).data('visibility');
        if (!url) return;
        const filename = url.substring(url.lastIndexOf('/') + 1);
        const fileInfo = this._fileInfo || null;
        initMediaModal(filename, undefined, visibility, false, fileInfo);
    });

    $(document).on('click', '.btn-delete', async function(event) {
        event.stopPropagation();
        const sha256 = $(this).data('sha256');
        const id = $(this).data('id');
        await initConfirmModal('#fileTable', [id], 'delete', 'file', '', false).then(async (modal) => {
            if (modal.result !== true) return;
            $.ajax({
                url: `/api/v2/media/${sha256}`,
                method: 'DELETE',
                success: function() {
                    $('#fileTable').bootstrapTable('remove', { field: 'sha256', values: [sha256] });
                    // Drop from virtual list and re-render the window.
                    galleryState.items = galleryState.items.filter(f => (f.sha256 || (f.tags && f.tags.find(t => t[0] === 'ox')?.[1])) !== sha256);
                    galleryState.renderedRange = { start: -1, end: -1 };
                    renderVisible();
                    showMessage(`File with sha256 ${sha256} deleted successfully`, 'alert-success');
                },
                error: function(err) {
                    console.error('Error deleting media', err);
                    showMessage(`Error deleting file with sha256 ${sha256}`, 'alert-danger');
                }
            });
        });
    });

    $(document).on('click', '.btn-report', async function(event) {
        event.stopPropagation();
        const sha256 = $(this).data('sha256');
        if (!sha256 || sha256 === 'N/A') {
            showMessage('Could not determine the file hash to report.', 'alert-danger');
            return;
        }
        const choice = await initReportModal(sha256);
        if (!choice) return;
        await submitBlobReport(choice.sha256, choice.type, choice.content);
    });

    $(document).on('click', '.btn-visibility', async function(event) {
        event.stopPropagation();
        const sha256 = $(this).data('sha256');
        const visibility = $(this).data('visibility') === 1 ? 0 : 1;
        const id = $(this).data('id');
        await initConfirmModal('#fileTable', [id], visibility === 1 ? 'show in gallery' : 'hide from gallery', 'file', '', false)
            .then(async (modal) => {
                if (modal.result !== true) return;
                $.ajax({
                    url: `/api/v2/media/${sha256}/visibility/${visibility}`,
                    method: 'PUT',
                    contentType: 'application/json',
                    success: function() {
                        $('#fileTable').bootstrapTable('updateByUniqueId', { id: id, row: { visibility: visibility } });
                        $(`[data-sha256="${sha256}"].btn-visibility`).each(function() {
                            $(this).attr('data-visibility', visibility);
                            $(this).data('visibility', visibility);
                            $(this).html(visibility === 1 ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>');
                        });
                        showMessage(`Visibility of file with sha256 ${sha256} updated successfully`, 'alert-success');
                    },
                    error: function(err) {
                        console.error('Error updating visibility', err);
                        showMessage(`Error updating visibility of file with sha256 ${sha256}`, 'alert-danger');
                    }
                });
            });
    });
});

function initVirtualScroll() {
    computeMetrics();
    // Attach listeners only once. If already attached, skip.
    if (!galleryState._listenersAttached) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
        galleryState._listenersAttached = true;
    }
    // Kick off the first page.
    if (galleryState.items.length === 0 && !galleryState.loading) {
        loadNextPage();
    } else {
        renderVisible();
    }
}

function computeMetrics() {
    const wrapper = document.getElementById('gallery-wrapper');
    if (!wrapper) return;
    const w = wrapper.clientWidth - 8; // padding
    if (w <= 0) return;
    const minTile = 240;
    const gap = 4;
    galleryState.columnsCount = Math.max(1, Math.floor((w + gap) / (minTile + gap)));
    galleryState.tileSize = Math.floor((w - (galleryState.columnsCount - 1) * gap) / galleryState.columnsCount);
    document.getElementById('gallery-grid').style.setProperty('--gallery-cols', galleryState.columnsCount);
}

function onScroll() {
    if (galleryState.scrollScheduled) return;
    galleryState.scrollScheduled = true;
    requestAnimationFrame(() => {
        galleryState.scrollScheduled = false;
        renderVisible();
    });
}

function onResize() {
    clearTimeout(galleryState.resizeTimer);
    galleryState.resizeTimer = setTimeout(() => {
        computeMetrics();
        galleryState.renderedRange = { start: -1, end: -1 };
        renderVisible();
    }, 100);
}

function resetGallery() {
    galleryState.aborter?.abort();
    galleryState.aborter = null;
    galleryState.cursor = null;
    galleryState.loading = false;
    galleryState.exhausted = false;
    galleryState.fileMasonryId = 0;
    galleryState.items = [];
    galleryState.renderedRange = { start: -1, end: -1 };
    galleryState.videoObserver?.disconnect();
    const grid = document.getElementById('gallery-grid');
    if (grid) {
        grid.innerHTML = '';
        grid.style.transform = 'translateY(0)';
    }
    const wrapper = document.getElementById('gallery-wrapper');
    if (wrapper) wrapper.style.height = '0px';
    document.getElementById('no-media')?.classList.add('visually-hidden');
}

async function loadNextPage() {
    if (galleryState.loading || galleryState.exhausted) return;
    galleryState.loading = true;

    galleryState.aborter?.abort();
    galleryState.aborter = new AbortController();

    const params = new URLSearchParams();
    params.set('limit', String(galleryState.pageSize));
    params.set('count', String(galleryState.pageSize));
    if (galleryState.cursor != null) params.set('before', String(galleryState.cursor));

    const apiURL = privateGallery
        ? `/api/v2/media?${params}`
        : pubkey
            ? `/api/v2/media/vanity/${pubkey}?${params}`
            : `/api/v2/media/listpublic?${params}`;

    let payload;
    try {
        const response = await fetch(apiURL, {
            method: 'GET',
            credentials: privateGallery ? 'include' : 'omit',
            signal: galleryState.aborter.signal,
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        payload = await response.json();
    } catch (err) {
        if (err.name === 'AbortError') return;
        console.error('gallery - fetch failed', err);
        document.getElementById('gallery-list-loading')?.remove();
        galleryState.loading = false;
        return;
    }

    const files = Array.isArray(payload) ? payload : payload.files;
    if (!Array.isArray(files) || files.length === 0) {
        galleryState.exhausted = true;
        galleryState.loading = false;
        document.getElementById('gallery-list-loading')?.remove();
        if (galleryState.items.length === 0) {
            document.getElementById('no-media')?.classList.remove('visually-hidden');
        }
        renderVisible();
        return;
    }

    // Append to the master list and advance the cursor to the smallest fileid.
    galleryState.items.push(...files);

    const fileIds = files.map(f => Number(f.fileid)).filter(n => Number.isFinite(n) && n > 0);
    if (fileIds.length > 0) {
        const minId = Math.min(...fileIds);
        if (galleryState.cursor === null || minId < galleryState.cursor) {
            galleryState.cursor = minId;
        } else {
            galleryState.exhausted = true;
        }
    } else {
        galleryState.exhausted = true;
    }

    if (files.length < galleryState.pageSize) galleryState.exhausted = true;
    if (galleryState.exhausted) document.getElementById('gallery-list-loading')?.remove();

    galleryState.loading = false;
    renderVisible();
}

function renderVisible() {
    const grid = document.getElementById('gallery-grid');
    const wrapper = document.getElementById('gallery-wrapper');
    if (!grid || !wrapper) return;

    if (galleryState.items.length === 0) {
        grid.innerHTML = '';
        wrapper.style.height = '0px';
        return;
    }

    const cols = galleryState.columnsCount;
    const gap = 4;
    const rowH = galleryState.tileSize + gap;
    const totalRows = Math.ceil(galleryState.items.length / cols);

    // Wrapper height = total virtual height. Lets the scrollbar reflect the
    // whole feed even though only a slice is mounted.
    wrapper.style.height = (totalRows * rowH) + 'px';

    // Compute the visible row range relative to the wrapper's top.
    const wrapperRect = wrapper.getBoundingClientRect();
    const wrapperTop = wrapperRect.top + window.scrollY;
    const viewTop = window.scrollY;
    const viewBottom = viewTop + window.innerHeight;
    const firstVisibleRow = Math.max(0, Math.floor((viewTop - wrapperTop) / rowH));
    const lastVisibleRow = Math.max(0, Math.ceil((viewBottom - wrapperTop) / rowH));

    const buffer = galleryState.bufferRows;
    const startRow = Math.max(0, firstVisibleRow - buffer);
    const endRow = Math.min(totalRows - 1, lastVisibleRow + buffer);
    const startIdx = startRow * cols;
    const endIdx = Math.min(galleryState.items.length, (endRow + 1) * cols);

    const sameRange = galleryState.renderedRange.start === startIdx && galleryState.renderedRange.end === endIdx;

    if (!sameRange) {
        // Disconnect existing video observers so removed videos don't keep
        // play/pause callbacks alive.
        galleryState.videoObserver?.disconnect();

        grid.innerHTML = '';
        grid.style.transform = `translateY(${startRow * rowH}px)`;

        const fragment = document.createDocumentFragment();
        for (let i = startIdx; i < endIdx; i++) {
            fragment.appendChild(createTile(galleryState.items[i]));
        }
        grid.appendChild(fragment);

        galleryState.renderedRange = { start: startIdx, end: endIdx };
    }

    // Pre-fetch next page when within the last few rows of what we have.
    if (lastVisibleRow >= totalRows - 5 && !galleryState.exhausted && !galleryState.loading) {
        loadNextPage();
    }
}

function getTagValue(file, key) {
    if (Array.isArray(file.tags)) {
        const found = file.tags.find(tag => tag[0] === key);
        return found ? found[1] : null;
    }
    return file[key] ?? null;
}

function paintBlurhash(canvas, hash, w, h) {
    if (!hash) return;
    canvas.dataset.bh = hash; // for the blurhash-ready repaint pass
    if (typeof window.blurhashDecode !== 'function') return;
    try {
        const pixels = window.blurhashDecode(hash, w, h);
        const ctx = canvas.getContext('2d');
        const imgData = ctx.createImageData(w, h);
        imgData.data.set(pixels);
        ctx.putImageData(imgData, 0, 0);
    } catch (e) {
        // Silent — placeholder just stays solid.
    }
}

// Repaint any placeholders that were appended before the lib finished loading.
window.addEventListener('blurhash-ready', () => {
    document.querySelectorAll('.blur-placeholder[data-bh]').forEach(c => {
        paintBlurhash(c, c.dataset.bh, 32, 32);
    });
});

function createTile(file) {
    const url = getTagValue(file, 'url');
    const blurhashStr = getTagValue(file, 'blurhash') || '';
    const visibility = getTagValue(file, 'visibility') ?? '';
    const ext = (url?.split('.').pop() || '').toLowerCase();

    const tile = document.createElement('div');
    tile.classList.add('gallery-tile');
    tile.setAttribute('role', 'listitem');
    const tileId = galleryState.fileMasonryId++;
    file.id = file.id ?? tileId;
    tile.id = `media-${tileId}`;
    tile.dataset.url = url || '';
    tile.dataset.visibility = visibility;
    tile._fileInfo = file;

    if (blurhashStr) {
        const ph = document.createElement('canvas');
        ph.classList.add('blur-placeholder');
        ph.width = 32; ph.height = 32;
        tile.appendChild(ph);
        paintBlurhash(ph, blurhashStr, 32, 32);
    }

    if (!url) {
        const fb = document.createElement('div');
        fb.classList.add('file-fallback');
        fb.textContent = '?';
        tile.appendChild(fb);
        return tile;
    }

    if (['webp', 'gif', 'jpg', 'jpeg', 'png', 'avif'].includes(ext)) {
        const img = document.createElement('img');
        img.loading = 'lazy';
        img.decoding = 'async';
        img.fetchPriority = 'low';
        img.alt = '';
        img.src = url;
        // Cache hit: the load event already fired and won't fire again, so
        // mark it loaded synchronously to skip the fade-in (and the flash
        // that would happen on every virtual-scroll re-mount).
        if (img.complete && img.naturalWidth > 0) {
            img.classList.add('is-loaded');
        } else {
            img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
        }
        tile.appendChild(img);
    } else if (['mp4', 'mov', 'webm'].includes(ext)) {
        const video = document.createElement('video');
        video.dataset.src = url;
        video.preload = 'metadata';
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.setAttribute('poster', '/static/resources/loading-video.webp');
        video.addEventListener('loadeddata', () => video.classList.add('is-loaded'), { once: true });
        tile.appendChild(video);
        galleryState.videoObserver.observe(video);
    } else if (ext === 'mp3' || ext === 'wav' || ext === 'ogg') {
        const wrap = document.createElement('div');
        wrap.classList.add('audio-tile');
        const audio = document.createElement('audio');
        audio.preload = 'none';
        audio.controls = true;
        audio.src = url;
        wrap.appendChild(audio);
        tile.appendChild(wrap);
    } else if (ext === 'stl') {
        const canvas = document.createElement('canvas');
        canvas.id = `media-3d-${tileId}`;
        canvas.style.background = '#D1CDCD';
        tile.appendChild(canvas);
        requestAnimationFrame(() => init3dViewer(canvas.id, tile.id, url, galleryState.tileSize, galleryState.tileSize));
    } else {
        const fb = document.createElement('div');
        fb.classList.add('file-fallback');
        fb.innerHTML = `<span class="display-6 gradient-text">.${ext || 'file'}</span>`;
        tile.appendChild(fb);
    }

    // Action buttons (info / view / report / visibility / delete).
    tile.appendChild(buttonContainer('masonry', file, privateGallery ? true : false));

    return tile;
}

function buttonContainer(type, file, auth) {

    const id = file.tags?.find(tag => tag[0] === 'id')?.[1] || file.id || '';
    const sha256 = file.tags?.find(tag => tag[0] === 'ox')?.[1] || file.sha256 || '';
    const url = file.tags?.find(tag => tag[0] === 'url')?.[1] || file.url || '';
    const payment_request = file.tags?.find(tag => tag[0] === 'payment_request')?.[1] || file.payment_request || '';
    const visibility = file.tags?.find(tag => tag[0] === 'visibility')?.[1] || file.visibility || '';

    const container = document.createElement('div');
    container.id = type + '-button-container-' + sha256;
    if (type === 'masonry') container.classList.add('btn-container');

    if (type === 'masonry') {
        const infoButton = document.createElement('button');
        infoButton.classList.add('btn', 'btn-primary', 'btn-xl', 'me-1', 'btn-info-action');
        infoButton.setAttribute('data-url', url);
        infoButton.setAttribute('data-visibility', visibility);
        infoButton.setAttribute('title', 'File info');
        infoButton.innerHTML = '<i class="fas fa-info"></i>';
        infoButton._fileInfo = file;
        container.appendChild(infoButton);
    }

    const viewButton = document.createElement('button');
    viewButton.id = type + '-view-button-' + sha256;
    viewButton.classList.add('btn', 'btn-primary', 'btn-xl', 'me-1', 'btn-dark', 'btn-view');
    viewButton.setAttribute('data-url', url);
    viewButton.innerHTML = '<i class="fa-solid fa-arrow-up-right-from-square"></i>';
    container.appendChild(viewButton);

    const reportButton = document.createElement('button');
    reportButton.classList.add('btn', 'btn-warning', 'btn-xl', 'me-1', 'btn-report');
    reportButton.setAttribute('data-sha256', sha256);
    reportButton.setAttribute('title', 'Report this file');
    reportButton.innerHTML = '<i class="fa-solid fa-flag"></i>';
    container.appendChild(reportButton);

    if (auth) {
        const visibleButton = document.createElement('button');
        visibleButton.classList.add('btn', 'btn-secondary', 'btn-xl', 'me-1', 'btn-visibility');
        visibleButton.setAttribute('data-sha256', sha256);
        visibleButton.setAttribute('data-visibility', visibility);
        visibleButton.setAttribute('data-id', file.id);
        visibleButton.innerHTML = visibleButton.getAttribute('data-visibility') == 1
            ? '<i class="fas fa-eye"></i>'
            : '<i class="fas fa-eye-slash"></i>';
        container.appendChild(visibleButton);

        const deleteButton = document.createElement('button');
        deleteButton.classList.add('btn', 'btn-danger', 'btn-xl', 'me-1', 'btn-delete');
        deleteButton.setAttribute('data-sha256', sha256);
        deleteButton.setAttribute('data-id', file.id);
        deleteButton.innerHTML = '<i class="fas fa-trash"></i>';
        container.appendChild(deleteButton);

        if (payment_request !== '') {
            const payButton = document.createElement('button');
            payButton.classList.add('btn', 'btn-warning', 'btn-xl', 'me-1');
            payButton.innerHTML = '<i class="fas fa-bolt"></i>';
            container.appendChild(payButton);
        }
    }

    return container;
}

function actionsFormatter(value, row) {
    return `<div class="text-start">${buttonContainer('list', row, row.auth).innerHTML}</div>`;
}

function detailFormatter(index, row) {
    const html = [];
    $.each(row, function (key, value) {
        if (key === 'state') return;
        html.push('<p><span class="key">' + key + ':</span> <span class="value">' + value + '</span></p>');
    });
    return `<div class="detail-container">${html.join('')}</div>`;
}

function filenameFormatter(value, row, index) {
    const textValue = value.slice(0, (value.length / 2) - 20) + ':' + value.slice((value.length / 2) + 20);
    const modalFileCheck = '<div id="file_' + index + '_preview"><span class="cursor-zoom-in text-secondary">' + textValue + '</span></div>';
    $(document).off('click', '#file_' + index + '_preview').on('click', '#file_' + index + '_preview', async function () {
        await initMediaModal(`${row.url.substring(row.url.lastIndexOf('/') + 1)}`, row.checked, row.visibility, false, row);
    });
    return modalFileCheck;
}

function dateSorter(a, b) {
    const [dayA, monthA, yearA] = a.split('/');
    const [dayB, monthB, yearB] = b.split('/');
    return new Date(`${yearA}-${monthA}-${dayA}`) - new Date(`${yearB}-${monthB}-${dayB}`);
}

function fetchTabledata(params) {
    const pageSize = params.data.pageSize;
    fetch(params.url, {
        method: 'GET',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
    })
    .then(response => response.json())
    .then(result => {
        const rows = result.slice(0, pageSize).map(file => ({
            id: fileTableId++,
            sha256: file.sha256 || 'N/A',
            m: file.type?.split('/')[1] || 'N/A',
            url: file.url || 'N/A',
            size: file.size ? (file.size / 1024).toFixed(2) + ' KB' : 'N/A',
            dim: file.dim && file.dim !== '0x0' ? file.dim : '',
            date: new Date(file.uploaded * 1000).toLocaleString().split(',')[0],
            payment_request: file.payment_request || '',
            actions: '',
            auth: privateGallery,
            visibility: file.visibility,
        }));
        params.success({ total: result.length, rows: rows });
    })
    .catch(err => params.error(err));
}
