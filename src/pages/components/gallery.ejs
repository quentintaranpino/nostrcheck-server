<% if (privateGallery) { %>
    <div id="gallery-view" class="d-flex justify-content-start align-items-center p-2">
        <span class="me-2 lead fs-6">Select view</span>
            <div id="viewSelector" class="btn-group">
                <button type="button" class="btn btn-secondary active" data-view="list" id="listView">
                    <i class="fas fa-list"></i>
                </button>
                <button type="button" class="btn btn-secondary" data-view="masonry" id="galleryView">
                    <i class="fas fa-images"></i>
                </button>
            </div>
    </div>

    <div id="list-container" class="g-2 p-2 pt-0 <%= privateGallery ? '' : 'visually-hidden' %>">
        <table id="fileTable"></table>
    </div>
<% } %>

<div id="gallery-grid" class="gallery-grid <%= privateGallery ? 'visually-hidden' : '' %>" role="list"></div>
<div id="no-media" class="visually-hidden text-center py-5 fs-4"><p>No media files found</p></div>
<div id="sentinel-end" aria-hidden="true"></div>
<%- !privateGallery ? include('./loading', {objectId: 'gallery-list', dataName: 'Files'}) : '' %>

<style>
    .gallery-grid {
        column-gap: 6px;
        padding: 4px;
        --gallery-cols: <%= maxColumns %>;
        column-count: var(--gallery-cols);
    }
    @media (max-width: 1400px) { .gallery-grid { --gallery-cols: 5; } }
    @media (max-width: 1100px) { .gallery-grid { --gallery-cols: 4; } }
    @media (max-width: 800px)  { .gallery-grid { --gallery-cols: 3; } }
    @media (max-width: 540px)  { .gallery-grid { --gallery-cols: 2; } }

    .gallery-tile {
        break-inside: avoid;
        margin: 0 0 6px 0;
        position: relative;
        border-radius: 6px;
        overflow: hidden;
        background: #1a1a1a;
        contain: layout paint;
        content-visibility: auto;
        contain-intrinsic-size: 220px 280px;
    }
    .gallery-tile > a { display: block; line-height: 0; }
    .gallery-tile img,
    .gallery-tile video,
    .gallery-tile canvas {
        display: block;
        width: 100%;
        height: auto;
    }
    .gallery-tile .blur-placeholder {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        transition: opacity 0.4s ease;
    }
    .gallery-tile img.is-loaded ~ .blur-placeholder,
    .gallery-tile video.is-loaded ~ .blur-placeholder { opacity: 0; pointer-events: none; }
    .gallery-tile .placeholder-fallback {
        width: 100%;
        aspect-ratio: 4 / 3;
        background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
    }
    .gallery-tile .video-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.25);
        color: #fff;
        font-size: 2.5rem;
        z-index: 2;
        cursor: pointer;
        pointer-events: auto;
    }
    .gallery-tile .file-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        aspect-ratio: 4 / 3;
        background: #fff;
        color: #333;
        font-size: 1.5rem;
        text-align: center;
    }
    .gallery-tile .btn-container {
        position: absolute;
        bottom: 4px;
        left: 4px;
        right: 4px;
        padding: 4px;
        background: rgba(0,0,0,0.45);
        border-radius: 5px;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 5;
    }
    .gallery-tile:hover .btn-container,
    .gallery-tile:focus-within .btn-container { opacity: 1; transform: translateY(0); }
    .gallery-tile .btn-container .btn { min-width: 40px; }
    .gallery-tile .audio-tile {
        background: url('/static/resources/loading-music.webp') center / cover no-repeat;
        aspect-ratio: 4 / 3;
        display: flex;
        align-items: flex-end;
        padding: 8px;
    }
    .gallery-tile .audio-tile audio { width: 100%; }
</style>

<script src="https://cdn.jsdelivr.net/npm/blurhash@1.1.4/dist/blurhash.min.js"></script>
<script>
const privateGallery = <%= privateGallery %>;
const pubkey = "<%= pubkey %>";

// Single source of truth for the gallery state. Reset entirely on view switch
// to avoid the memory leaks the old masonry impl had on repeated toggles.
const galleryState = {
    aborter: null,        // AbortController for the in-flight fetch
    cursor: null,         // last-seen fileid; null on first load
    pageSize: 30,
    loading: false,
    exhausted: false,
    observer: null,
    fileMasonryId: 0,
};

let fileTableId = 0;
let lastClickedTile = null;

document.addEventListener('DOMContentLoaded', () => {

    // Private gallery list view (bootstrap-table). Untouched.
    if (privateGallery) {
        $('#fileTable').bootstrapTable({
            columns: [
                { field: 'id', title: 'ID', class: 'text-center', sortable: true },
                { field: 'sha256', title: 'Filename', formatter: filenameFormatter, class: 'text-center', sortable: true },
                { field: 'm', title: 'Type', class: 'text-center', sortable: true },
                { field: 'url', title: 'Url', formatter: filenameFormatter, class: 'text-center d-none', sortable: true },
                { field: 'size', title: 'Size', class: 'text-center', sortable: true },
                { field: 'dim', title: 'Dimensions', class: 'text-center', sortable: true, visible: false },
                { field: 'date', title: 'Date', class: 'text-center', sortable: true, sorter: dateSorter },
                { field: 'payment_request', title: 'Payment Request', class: 'text-center', sortable: true, visible: false },
                { field: 'actions', title: 'Actions', formatter: actionsFormatter, class: 'text-center', sortable: false },
                { field: 'visibility', title: 'Visibility', class: 'text-center', visible: false },
                { field: 'auth', visible: false }
            ],
            idField: 'id',
            uniqueId: 'id',
            url: `/api/v2/media/list/${pubkey}`,
            ajax: function (params) { fetchTabledata(params) },
            data: [],
            search: true,
            searchAlign: 'left',
            mobileResponsive: true,
            minWidth: 1024,
            sortable: true,
            pagination: true,
            sidePagination: 'client',
            pageSize: 10,
            showColumns: true,
            detailView: true,
            detailFormatter: detailFormatter,
        });
    }

    const grid = document.getElementById('gallery-grid');
    const sentinel = document.getElementById('sentinel-end');

    // One observer for the whole gallery — never per-tile. Re-armed only when
    // a fetch finishes; this dedups the storm of intersections on fast scroll.
    galleryState.observer = new IntersectionObserver((entries) => {
        if (entries.some(e => e.isIntersecting)) loadNextPage();
    }, { rootMargin: '300px' });

    // Only attach the observer when there's an actual gallery to populate
    // (private view starts on the list tab; switching to masonry attaches it).
    if (!privateGallery) {
        galleryState.observer.observe(sentinel);
    }

    // Private gallery view switcher.
    document.getElementById('viewSelector')?.addEventListener('click', (event) => {
        const btn = event.target.closest('.btn');
        if (!btn) return;
        const view = btn.getAttribute('data-view');
        const masonryView = document.getElementById('gallery-grid');
        const listView = document.getElementById('list-container');
        document.querySelectorAll('#viewSelector .btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (view === 'masonry') {
            masonryView.classList.remove('visually-hidden');
            listView.classList.add('visually-hidden');
            // Reset cursor and re-arm observer.
            resetGallery();
            galleryState.observer.observe(sentinel);
        } else {
            masonryView.classList.add('visually-hidden');
            listView.classList.remove('visually-hidden');
            document.getElementById('gallery-list-loading')?.remove();
            galleryState.observer.unobserve(sentinel);
            // Cancel any in-flight fetch — we won't need its result.
            galleryState.aborter?.abort();
        }
    });

    // Tile action delegation. Single listener at document level, no per-tile
    // bindings (the old code attached observers and click handlers per item).
    $(document).on('click', '.btn-view', function(event) {
        event.stopPropagation();
        window.open($(this).data('url'), '_blank');
    });

    $(document).on('click', '.btn-delete', async function(event) {
        event.stopPropagation();
        const sha256 = $(this).data('sha256');
        const id = $(this).data('id');
        await initConfirmModal('#fileTable', [id], 'delete', 'file', '', false).then(async (modal) => {
            if (modal.result !== true) return;
            $.ajax({
                url: `/api/v2/media/${sha256}`,
                method: 'DELETE',
                success: function() {
                    $('#fileTable').bootstrapTable('remove', { field: 'sha256', values: [sha256] });
                    document.getElementById(`media-${id}`)?.remove();
                    showMessage(`File with sha256 ${sha256} deleted successfully`, 'alert-success');
                },
                error: function(err) {
                    console.error('Error deleting media', err);
                    showMessage(`Error deleting file with sha256 ${sha256}`, 'alert-danger');
                }
            });
        });
    });

    $(document).on('click', '.btn-report', async function(event) {
        event.stopPropagation();
        const sha256 = $(this).data('sha256');
        if (!sha256 || sha256 === 'N/A') {
            showMessage('Could not determine the file hash to report.', 'alert-danger');
            return;
        }
        const choice = await initReportModal(sha256);
        if (!choice) return;
        await submitBlobReport(choice.sha256, choice.type, choice.content);
    });

    $(document).on('click', '.btn-visibility', async function(event) {
        event.stopPropagation();
        const sha256 = $(this).data('sha256');
        const visibility = $(this).data('visibility') === 1 ? 0 : 1;
        const id = $(this).data('id');
        await initConfirmModal('#fileTable', [id], visibility === 1 ? 'show in gallery' : 'hide from gallery', 'file', '', false)
            .then(async (modal) => {
                if (modal.result !== true) return;
                $.ajax({
                    url: `/api/v2/media/${sha256}/visibility/${visibility}`,
                    method: 'PUT',
                    contentType: 'application/json',
                    success: function() {
                        $('#fileTable').bootstrapTable('updateByUniqueId', { id: id, row: { visibility: visibility } });
                        $(`[data-sha256="${sha256}"].btn-visibility`).each(function() {
                            $(this).attr('data-visibility', visibility);
                            $(this).data('visibility', visibility);
                            $(this).html(visibility === 1 ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>');
                        });
                        showMessage(`Visibility of file with sha256 ${sha256} updated successfully`, 'alert-success');
                    },
                    error: function(err) {
                        console.error('Error updating visibility', err);
                        showMessage(`Error updating visibility of file with sha256 ${sha256}`, 'alert-danger');
                    }
                });
            });
    });
});

function resetGallery() {
    galleryState.aborter?.abort();
    galleryState.aborter = null;
    galleryState.cursor = null;
    galleryState.loading = false;
    galleryState.exhausted = false;
    galleryState.fileMasonryId = 0;
    document.getElementById('gallery-grid').innerHTML = '';
    document.getElementById('no-media')?.classList.add('visually-hidden');
}

async function loadNextPage() {
    if (galleryState.loading || galleryState.exhausted) return;
    galleryState.loading = true;

    // Cancel any previous in-flight fetch — defensive, the loading flag
    // should already prevent this, but cheap insurance.
    galleryState.aborter?.abort();
    galleryState.aborter = new AbortController();

    const params = new URLSearchParams();
    params.set('limit', String(galleryState.pageSize));
    params.set('count', String(galleryState.pageSize));
    if (galleryState.cursor != null) {
        params.set('before', String(galleryState.cursor));
    }

    const apiURL = privateGallery
        ? `/api/v2/media?${params}`
        : pubkey
            ? `/api/v2/media/vanity/${pubkey}?${params}`
            : `/api/v2/media/listpublic?${params}`;

    let payload;
    try {
        const response = await fetch(apiURL, {
            method: 'GET',
            credentials: privateGallery ? 'include' : 'omit',
            signal: galleryState.aborter.signal,
        });
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }
        payload = await response.json();
    } catch (err) {
        if (err.name === 'AbortError') return;
        console.error('gallery - fetch failed', err);
        document.getElementById('gallery-list-loading')?.remove();
        galleryState.loading = false;
        return;
    }

    const files = Array.isArray(payload) ? payload : payload.files;
    if (!Array.isArray(files) || files.length === 0) {
        galleryState.exhausted = true;
        galleryState.loading = false;
        document.getElementById('gallery-list-loading')?.remove();
        if (galleryState.cursor === null) {
            // First page came back empty — nothing to show.
            document.getElementById('no-media')?.classList.remove('visually-hidden');
        }
        return;
    }

    renderTiles(files, privateGallery);

    // Advance the cursor to the smallest fileid we just received.
    const fileIds = files.map(f => Number(f.fileid)).filter(n => Number.isFinite(n) && n > 0);
    if (fileIds.length > 0) {
        const minId = Math.min(...fileIds);
        // Only advance if it actually moved; otherwise we'd loop on the same
        // page forever if the backend returned junk fileids.
        if (galleryState.cursor === null || minId < galleryState.cursor) {
            galleryState.cursor = minId;
        } else {
            galleryState.exhausted = true;
        }
    } else {
        // No usable cursor in the response → stop, we'd loop otherwise.
        galleryState.exhausted = true;
    }

    if (files.length < galleryState.pageSize) galleryState.exhausted = true;
    if (galleryState.exhausted) document.getElementById('gallery-list-loading')?.remove();

    galleryState.loading = false;
}

function getTagValue(file, key) {
    if (Array.isArray(file.tags)) {
        const found = file.tags.find(tag => tag[0] === key);
        return found ? found[1] : null;
    }
    return file[key] ?? null;
}

function paintBlurhash(canvas, hash, w, h) {
    if (!hash || typeof blurhash === 'undefined') return;
    try {
        const pixels = blurhash.decode(hash, w, h);
        const ctx = canvas.getContext('2d');
        const imgData = ctx.createImageData(w, h);
        imgData.data.set(pixels);
        ctx.putImageData(imgData, 0, 0);
    } catch (e) {
        // Silent — placeholder just stays solid.
    }
}

function renderTiles(files, auth) {
    const grid = document.getElementById('gallery-grid');
    const fragment = document.createDocumentFragment();

    for (const file of files) {
        const url = getTagValue(file, 'url');
        if (!url) continue;
        const dim = getTagValue(file, 'dim') || '';
        const blurhashStr = getTagValue(file, 'blurhash') || '';
        const ext = (url.split('.').pop() || '').toLowerCase();
        const [w, h] = dim.split('x').map(n => parseInt(n, 10));
        const aspect = (Number.isFinite(w) && Number.isFinite(h) && w > 0 && h > 0) ? `${w} / ${h}` : '4 / 3';

        const tile = document.createElement('div');
        tile.classList.add('gallery-tile');
        tile.setAttribute('role', 'listitem');
        const tileId = galleryState.fileMasonryId++;
        file.id = file.id ?? tileId;
        tile.id = `media-${tileId}`;
        tile.style.aspectRatio = aspect;

        // Blurhash placeholder — decoded synchronously but to a 32x32 canvas
        // so it's cheap. Falls back to a flat gradient if no hash.
        if (blurhashStr) {
            const ph = document.createElement('canvas');
            ph.classList.add('blur-placeholder');
            ph.width = 32; ph.height = 32;
            tile.appendChild(ph);
            paintBlurhash(ph, blurhashStr, 32, 32);
        }

        const link = document.createElement('a');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        tile.appendChild(link);

        if (['webp', 'gif', 'jpg', 'jpeg', 'png', 'avif'].includes(ext)) {
            const img = document.createElement('img');
            img.src = url;
            img.loading = 'lazy';
            img.decoding = 'async';
            img.fetchPriority = 'low';
            img.alt = '';
            img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
            link.appendChild(img);
        } else if (['mp4', 'mov', 'webm'].includes(ext)) {
            // Click-to-load video — no autoplay, no per-tile observer.
            const overlay = document.createElement('div');
            overlay.classList.add('video-overlay');
            overlay.innerHTML = '<i class="fas fa-play-circle"></i>';
            tile.appendChild(overlay);

            const video = document.createElement('video');
            video.preload = 'none';
            video.controls = true;
            video.playsInline = true;
            video.muted = true;
            video.classList.add('visually-hidden');
            link.appendChild(video);

            overlay.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                video.src = url;
                video.classList.remove('visually-hidden');
                video.classList.add('is-loaded');
                overlay.remove();
                video.play().catch(() => {});
            }, { once: true });
        } else if (ext === 'mp3' || ext === 'wav' || ext === 'ogg') {
            const wrap = document.createElement('div');
            wrap.classList.add('audio-tile');
            const audio = document.createElement('audio');
            audio.preload = 'none';
            audio.controls = true;
            audio.src = url;
            wrap.appendChild(audio);
            link.appendChild(wrap);
        } else if (ext === 'stl') {
            const canvas = document.createElement('canvas');
            canvas.id = `media-3d-${tileId}`;
            canvas.style.background = '#D1CDCD';
            canvas.style.width = '100%';
            canvas.style.height = '220px';
            link.appendChild(canvas);
            // Defer so the tile is in the DOM when the viewer initialises.
            requestAnimationFrame(() => init3dViewer(canvas.id, tile.id, url, 250, 200));
        } else {
            const fallback = document.createElement('div');
            fallback.classList.add('file-fallback');
            fallback.innerHTML = `<a href="${url}" download class="text-decoration-none"><span class="display-6 gradient-text">.${ext || 'file'}</span></a>`;
            link.appendChild(fallback);
        }

        // Action buttons (view / report / visibility / delete) — same
        // helper as before, just attached to the tile root.
        tile.appendChild(buttonContainer('masonry', file, auth));

        // Click toggles button container visibility (single tile-at-a-time).
        tile.addEventListener('click', () => {
            if (lastClickedTile && lastClickedTile !== tile) {
                lastClickedTile.querySelector('.btn-container')?.style.setProperty('opacity', '0');
            }
            tile.querySelector('.btn-container')?.style.setProperty('opacity', '1');
            lastClickedTile = tile;
        });

        fragment.appendChild(tile);
    }

    grid.appendChild(fragment);
}

function buttonContainer(type, file, auth) {

    const id = file.tags?.find(tag => tag[0] === 'id')?.[1] || file.id || '';
    const sha256 = file.tags?.find(tag => tag[0] === 'ox')?.[1] || file.sha256 || '';
    const url = file.tags?.find(tag => tag[0] === 'url')?.[1] || file.url || '';
    const payment_request = file.tags?.find(tag => tag[0] === 'payment_request')?.[1] || file.payment_request || '';
    const visibility = file.tags?.find(tag => tag[0] === 'visibility')?.[1] || file.visibility || '';

    const container = document.createElement('div');
    container.id = type + '-button-container-' + sha256;

    if (type === 'masonry') {
        container.classList.add('btn-container');
    }

    if (type === 'masonry') {
        const infoButton = document.createElement('button');
        infoButton.classList.add('btn', 'btn-primary', 'btn-xl', 'me-1');
        infoButton.innerHTML = '<i class="fas fa-info"></i>';
        container.appendChild(infoButton);
    }

    const viewButton = document.createElement('button');
    viewButton.id = type + '-view-button-' + sha256;
    viewButton.classList.add('btn', 'btn-primary', 'btn-xl', 'me-1', 'btn-dark', 'btn-view');
    viewButton.setAttribute('data-url', url);
    viewButton.innerHTML = '<i class="fa-solid fa-arrow-up-right-from-square"></i>';
    container.appendChild(viewButton);

    const reportButton = document.createElement('button');
    reportButton.classList.add('btn', 'btn-warning', 'btn-xl', 'me-1', 'btn-report');
    reportButton.setAttribute('data-sha256', sha256);
    reportButton.setAttribute('title', 'Report this file');
    reportButton.innerHTML = '<i class="fa-solid fa-flag"></i>';
    container.appendChild(reportButton);

    if (auth) {
        const visibleButton = document.createElement('button');
        visibleButton.classList.add('btn', 'btn-secondary', 'btn-xl', 'me-1', 'btn-visibility');
        visibleButton.setAttribute('data-sha256', sha256);
        visibleButton.setAttribute('data-visibility', visibility);
        visibleButton.setAttribute('data-id', file.id);
        visibleButton.innerHTML = visibleButton.getAttribute('data-visibility') == 1
            ? '<i class="fas fa-eye"></i>'
            : '<i class="fas fa-eye-slash"></i>';
        container.appendChild(visibleButton);

        const deleteButton = document.createElement('button');
        deleteButton.classList.add('btn', 'btn-danger', 'btn-xl', 'me-1', 'btn-delete');
        deleteButton.setAttribute('data-sha256', sha256);
        deleteButton.setAttribute('data-id', file.id);
        deleteButton.innerHTML = '<i class="fas fa-trash"></i>';
        container.appendChild(deleteButton);

        if (payment_request !== '') {
            const payButton = document.createElement('button');
            payButton.classList.add('btn', 'btn-warning', 'btn-xl', 'me-1');
            payButton.innerHTML = '<i class="fas fa-bolt"></i>';
            container.appendChild(payButton);
        }
    }

    return container;
}

function actionsFormatter(value, row) {
    return `<div class="text-start">${buttonContainer('list', row, row.auth).innerHTML}</div>`;
}

function detailFormatter(index, row) {
    const html = [];
    $.each(row, function (key, value) {
        if (key === 'state') return;
        html.push('<p><span class="key">' + key + ':</span> <span class="value">' + value + '</span></p>');
    });
    return `<div class="detail-container">${html.join('')}</div>`;
}

function filenameFormatter(value, row, index) {
    const textValue = value.slice(0, (value.length / 2) - 20) + ':' + value.slice((value.length / 2) + 20);
    const modalFileCheck = '<div id="file_' + index + '_preview"><span class="cursor-zoom-in text-secondary">' + textValue + '</span></div>';
    $(document).off('click', '#file_' + index + '_preview').on('click', '#file_' + index + '_preview', async function () {
        await initMediaModal(`${row.url.substring(row.url.lastIndexOf('/') + 1)}`, row.checked, row.visibility, false);
    });
    return modalFileCheck;
}

function dateSorter(a, b) {
    const [dayA, monthA, yearA] = a.split('/');
    const [dayB, monthB, yearB] = b.split('/');
    return new Date(`${yearA}-${monthA}-${dayA}`) - new Date(`${yearB}-${monthB}-${dayB}`);
}

function fetchTabledata(params) {
    const pageSize = params.data.pageSize;
    fetch(params.url, {
        method: 'GET',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
    })
    .then(response => response.json())
    .then(result => {
        const rows = result.slice(0, pageSize).map(file => ({
            id: fileTableId++,
            sha256: file.sha256 || 'N/A',
            m: file.type?.split('/')[1] || 'N/A',
            url: file.url || 'N/A',
            size: file.size ? (file.size / 1024).toFixed(2) + ' KB' : 'N/A',
            dim: file.dim && file.dim !== '0x0' ? file.dim : '',
            date: new Date(file.uploaded * 1000).toLocaleString().split(',')[0],
            payment_request: file.payment_request || '',
            actions: '',
            auth: privateGallery,
            visibility: file.visibility,
        }));
        params.success({ total: result.length, rows: rows });
    })
    .catch(err => params.error(err));
}
</script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="/static/js/viewers/3dviewer.js"></script>
