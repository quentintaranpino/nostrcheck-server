---
import Layout from '../layouts/Layout.astro';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/martian-mono';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

/**
 * Scratch page for picking the type pairing. Not linked from anywhere and
 * noindex; delete it once the choice is made.
 */
const pairings = [
	{
		id: 'current', name: 'Current', sans: "'Space Grotesk Variable'", mono: "'JetBrains Mono Variable'",
		note: 'What ships today. Space Grotesk is the saturated web3 default; JetBrains Mono is the most common coding face there is.',
	},
	{
		id: 'plex', name: 'IBM Plex', sans: "'IBM Plex Sans Variable'", mono: "'IBM Plex Mono'",
		note: 'One superfamily, so the pairing is correct by construction. Engineering heritage, real character in a hex string without being quirky.',
	},
	{
		id: 'instrument', name: 'Instrument + Martian', sans: "'Instrument Sans Variable'", mono: "'Martian Mono Variable'",
		note: 'The loudest option. Martian Mono is wide and deliberate — a key becomes an object. Costs horizontal room.',
	},
	{
		id: 'geist', name: 'Geist', sans: "'Geist Variable'", mono: "'Geist Mono Variable'",
		note: 'Vercel’s pair. Extremely clean and neutral; the risk is reading as generic developer-tool rather than as you.',
	},
];

const NPUB = 'npub10elfcs4fr0l0r8af98jlmgdh9c8tcxjvz9qkw038js35mp4dma8qzvjptg';
const HEX = '7e7e9c42a91bfef19fa929e5fda1b72e0ebc1a4c1141673e2794234d86addf4e';
---
<Layout title="Font lab" noindex={true} width="wide">
	<header class="fl-head">
		<h1>Font lab</h1>
		<p>Same content, four pairings. Judge the mono hardest — keys and hashes are what this site mostly shows.</p>
	</header>

	{pairings.map(p => (
		<section class="fl" style={`--fl-sans:${p.sans}; --fl-mono:${p.mono};`}>
			<div class="fl-meta">
				<h2>{p.name}</h2>
				<p>{p.note}</p>
				<p class="fl-stack"><code>{p.sans}</code> + <code>{p.mono}</code></p>
			</div>
			<div class="fl-demo">
				<h3 class="fl-h">Nostr tools</h3>
				<p class="fl-body">
					Keys, events and blobs, handled entirely in this browser. Nothing you
					paste or pick is sent anywhere else.
				</p>
				<p class="fl-label">hex public key</p>
				<p class="fl-value">{HEX}</p>
				<p class="fl-label">npub</p>
				<p class="fl-value">{NPUB}</p>
				<p class="fl-small">v0.8.0.0026 · 28 NIPs · 9 BUDs · wss://relay.nostrcheck.me</p>
			</div>
		</section>
	))}
</Layout>

<style is:global>
	.fl-head { margin-bottom: var(--space-7); }
	.fl-head h1 { margin: 0 0 var(--space-3); }
	.fl-head p { color: var(--ink-muted); max-width: 62ch; margin: 0; }

	.fl {
		display: grid;
		grid-template-columns: 18rem 1fr;
		gap: var(--space-6);
		align-items: start;
		border-top: 1px solid var(--border);
		padding: var(--space-6) 0;
	}
	.fl-meta h2 { font-size: var(--text-lg); margin: 0 0 var(--space-2); }
	.fl-meta p {
		color: var(--ink-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		margin: 0 0 var(--space-3);
	}
	.fl-stack code { font-family: var(--font-mono); font-size: var(--text-xs); }

	.fl-demo { min-width: 0; }
	.fl-h {
		font-family: var(--fl-sans);
		font-size: var(--text-2xl);
		letter-spacing: var(--tracking-tight);
		margin: 0 0 var(--space-3);
	}
	.fl-body {
		font-family: var(--fl-sans);
		color: var(--ink-muted);
		line-height: var(--leading-normal);
		max-width: 60ch;
		margin: 0 0 var(--space-5);
	}
	.fl-label {
		font-family: var(--fl-sans);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-muted);
		margin: 0 0 var(--space-2);
	}
	.fl-value {
		font-family: var(--fl-mono);
		font-size: var(--text-base);
		line-height: 1.4;
		word-break: break-all;
		margin: 0 0 var(--space-4);
	}
	.fl-small {
		font-family: var(--fl-mono);
		font-size: var(--text-xs);
		color: var(--ink-muted);
		margin: 0;
	}

	@media (max-width: 800px) {
		.fl { grid-template-columns: 1fr; gap: var(--space-4); }
	}
</style>
