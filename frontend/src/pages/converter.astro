---
import Layout from '../layouts/Layout.astro';
import ConverterIsland from '../components/ConverterIsland.tsx';
---
<Layout page="converter" width="bleed">
	<div class="pc-page">
		<div class="pc-page-inner">
			<header class="pc-head">
				<h1>Key converter</h1>
				<p class="pc-lede">
					One field. It reads npub, nsec, note, nevent, nprofile and raw hex,
					and shows you everything it can derive.
				</p>
			</header>

			<ConverterIsland client:load />
		</div>
	</div>
</Layout>

<style is:global>
	/* ─────────────────────────────────────────────────────────────
	   Poster register. Colour blocking carries the hierarchy: the
	   input sits on a saturated block so the action is unmistakable,
	   and the recognised type is set enormous behind the composition
	   — decoration that is also information, since it names what the
	   field just understood. No glow, no grid, no neon.
	   Page-local tokens, gated by check-contrast.mjs.
	   ───────────────────────────────────────────────────────────── */
	.pc-page {
		--pc-bg: oklch(0.13 0.02 300);
		--pc-ink: oklch(0.97 0.01 300);
		--pc-dim: oklch(0.72 0.04 300);
		--pc-block: oklch(0.5 0.19 300);
		--pc-block-ink: oklch(0.99 0.005 300);
		--pc-ghost: oklch(0.22 0.045 300);
		--pc-rule: oklch(0.49 0.03 300);
		--pc-danger: oklch(0.72 0.18 25);

		padding: var(--space-8) var(--space-5) var(--space-8);
		min-height: 84vh;
		background: var(--pc-bg);
		color: var(--pc-ink);
	}
	html[data-bs-theme="light"] .pc-page {
		--pc-bg: oklch(0.985 0.004 300);
		--pc-ink: oklch(0.18 0.02 300);
		--pc-dim: oklch(0.44 0.04 300);
		--pc-block: oklch(0.42 0.19 300);
		--pc-block-ink: oklch(0.99 0.005 300);
		--pc-ghost: oklch(0.93 0.025 300);
		--pc-rule: oklch(0.64 0.02 300);
		--pc-danger: oklch(0.46 0.19 25);
	}

	.pc-page-inner { max-width: 62rem; margin-inline: auto; }

	.pc-head { margin-bottom: var(--space-6); }
	.pc-page h1 {
		font-size: var(--text-xl);
		letter-spacing: var(--tracking-snug);
		margin: 0 0 var(--space-3);
	}
	.pc-lede {
		color: var(--pc-dim);
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		max-width: 54ch;
		margin: 0;
	}

	/* ── The ghost word ───────────────────────────────────────── */
	/* Its own band under the action block, clipped: it fills the empty space
	   below and sits behind the readout, and it can never reach the copy. */
	.pc-readout {
		position: relative;
		overflow: clip;
		min-height: 16rem;
		padding-top: var(--space-5);
	}
	.pc-ghost {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 0;
		max-width: 100%;
		font-family: var(--font-mono);
		font-size: clamp(4rem, 15vw, 11rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.05em;
		text-transform: uppercase;
		color: var(--pc-ghost);
		pointer-events: none;
		user-select: none;
		/* It's texture, so it must never fight the readout it sits over. */
		transition: color var(--dur-base) var(--ease-out);
	}
	.pc[data-type="nsec"] .pc-ghost { color: oklch(0.26 0.07 25); }
	html[data-bs-theme="light"] .pc[data-type="nsec"] .pc-ghost { color: oklch(0.92 0.04 25); }

	.pc-panel, .pc-out, .pc-warn, .pc-nothing { position: relative; z-index: 1; }

	/* ── The action block ─────────────────────────────────────── */
	.pc-panel {
		background: var(--pc-block);
		color: var(--pc-block-ink);
		padding: var(--space-5);
	}
	.pc-prompt {
		display: block;
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		opacity: 0.85;
		margin-bottom: var(--space-3);
	}
	.pc-field {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
		border-bottom: 2px solid var(--pc-block-ink);
		padding-bottom: var(--space-3);
	}
	.pc-input {
		flex: 1;
		min-width: 0;
		background: none;
		border: 0;
		padding: 0;
		color: var(--pc-block-ink);
		font-family: var(--font-mono);
		font-size: clamp(1rem, 2.2vw, 1.375rem);
	}
	.pc-input:focus { outline: none; }
	.pc-input::placeholder { color: var(--pc-block-ink); opacity: 0.6; font-size: var(--text-sm); }
	.pc-field:focus-within { border-bottom-color: var(--pc-block-ink); }
	.pc-tag {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		opacity: 0.9;
	}

	.pc-actions {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
		margin-top: var(--space-4);
	}
	.pc-generate {
		background: var(--pc-block-ink);
		color: var(--pc-block);
		border: 0;
		border-radius: 0;
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 600;
		padding: var(--space-3) var(--space-5);
		cursor: pointer;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.pc-generate:hover { opacity: 0.88; }
	.pc-clear {
		background: none;
		border: 1px solid var(--pc-block-ink);
		border-radius: 0;
		color: var(--pc-block-ink);
		font: inherit;
		font-size: var(--text-sm);
		padding: var(--space-3) var(--space-4);
		cursor: pointer;
		opacity: 0.8;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.pc-clear:hover { opacity: 1; }
	.pc-note { margin-left: auto; font-size: var(--text-xs); opacity: 0.8; }

	/* ── Readout ──────────────────────────────────────────────── */
	.pc-warn, .pc-nothing {
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		margin: var(--space-5) 0 0;
		max-width: 60ch;
	}
	.pc-warn { color: var(--pc-danger); font-weight: 600; }
	.pc-nothing { color: var(--pc-dim); }

	.pc-out { list-style: none; margin: var(--space-6) 0 0; padding: 0; }
	.pc-out li {
		border-top: 1px solid var(--pc-rule);
		animation: pc-in 280ms var(--ease-out) backwards;
		animation-delay: calc(var(--i, 0) * 60ms);
	}
	.pc-out li:last-child { border-bottom: 1px solid var(--pc-rule); }
	@keyframes pc-in { from { opacity: 0; transform: translateY(6px); } }

	.pc-out-btn {
		width: 100%;
		display: block;
		background: none;
		border: 0;
		border-radius: 0;
		padding: var(--space-4) var(--space-3);
		text-align: left;
		cursor: pointer;
		font: inherit;
		color: inherit;
		transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}
	.pc-out-btn:hover, .pc-out-btn:focus-visible {
		background: var(--pc-block);
		color: var(--pc-block-ink);
		outline: none;
	}
	.pc-out-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--pc-dim);
		margin-bottom: var(--space-3);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.pc-out-btn:hover .pc-out-head,
	.pc-out-btn:focus-visible .pc-out-head { color: var(--pc-block-ink); }
	.pc-out-copy { flex-shrink: 0; }
	.pc-out-value {
		display: block;
		font-family: var(--font-mono);
		font-size: clamp(1.0625rem, 3vw, 1.75rem);
		line-height: 1.3;
		letter-spacing: -0.02em;
		word-break: break-all;
	}

	@media (max-width: 620px) {
		.pc-note { margin-left: 0; }
		.pc-ghost { top: -0.2em; opacity: 0.75; }
	}

	@media (prefers-reduced-motion: reduce) {
		.pc-out li { animation: none; }
		.pc-ghost { transition: none; }
	}
</style>
