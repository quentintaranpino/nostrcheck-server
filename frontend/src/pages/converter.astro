---
import Layout from '../layouts/Layout.astro';
import ConverterIsland from '../components/ConverterIsland.tsx';
---
<Layout page="converter" width="bleed">
	<div class="kc-page">
		<div class="kc-page-inner">
			<header class="kc-head">
				<h1>Key converter</h1>
				<p class="kc-lede">
					One field. It reads npub, nsec, note, nevent, nprofile and raw hex,
					and shows you everything it can derive.
				</p>
			</header>

			<ConverterIsland client:load />
		</div>
	</div>
</Layout>

<style is:global>
	/* ─────────────────────────────────────────────────────────────
	   Drenched register. The colour strategy here is not "restrained
	   plus an accent" — the brand purple IS the surface. The drama
	   comes from saturation and from the size of the values, because
	   the value is what the visitor came for. No glow, no grid, no
	   scanlines: the data carries the page.
	   Tokens are page-local; check-contrast.mjs gates them.
	   ───────────────────────────────────────────────────────────── */
	.kc-page {
		--kc-field: oklch(0.24 0.13 300);
		--kc-ink: oklch(0.97 0.01 300);
		--kc-dim: oklch(0.8 0.05 300);
		--kc-rule: oklch(0.55 0.1 300);
		--kc-tag: oklch(0.88 0.1 300);
		--kc-danger: oklch(0.8 0.16 25);

		/* Layout is in bleed mode, so this is already the full width — no vw
		   maths, no scrollbar overflow. */
		padding: var(--space-8) var(--space-5);
		min-height: 82vh;
		background: var(--kc-field);
		color: var(--kc-ink);
	}
	html[data-bs-theme="light"] .kc-page {
		--kc-field: oklch(0.95 0.05 300);
		--kc-ink: oklch(0.24 0.13 300);
		--kc-dim: oklch(0.44 0.1 300);
		--kc-rule: oklch(0.62 0.1 300);
		--kc-tag: oklch(0.36 0.16 300);
		--kc-danger: oklch(0.44 0.18 25);
	}

	.kc-page-inner { max-width: 54rem; margin-inline: auto; }

	.kc-head { margin-bottom: var(--space-7); }
	.kc-page h1 {
		font-size: var(--text-xl);
		letter-spacing: var(--tracking-snug);
		margin: 0 0 var(--space-3);
	}
	.kc-lede {
		color: var(--kc-dim);
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		max-width: 54ch;
		margin: 0;
	}

	/* ── Input: a line to write on, not a box ─────────────────── */
	.kc-prompt {
		display: block;
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--kc-dim);
		margin-bottom: var(--space-3);
	}
	.kc-field {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
		border-bottom: 2px solid var(--kc-rule);
		padding-bottom: var(--space-3);
		transition: border-color var(--dur-base) var(--ease-out);
	}
	.kc-field:focus-within,
	.kc-field:not([data-type="empty"]):not([data-type="unknown"]) { border-bottom-color: var(--kc-ink); }
	.kc-field[data-type="nsec"] { border-bottom-color: var(--kc-danger); }

	.kc-input {
		flex: 1;
		min-width: 0;
		background: none;
		border: 0;
		padding: 0;
		color: var(--kc-ink);
		font-family: var(--font-mono);
		font-size: clamp(1rem, 2.2vw, 1.375rem);
	}
	.kc-input:focus { outline: none; }
	.kc-input::placeholder {
		color: var(--kc-dim);
		opacity: 1;
		font-size: var(--text-sm);
	}
	.kc-tag {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--kc-tag);
	}
	.kc-tag[data-type="nsec"] { color: var(--kc-danger); }

	/* ── Actions ──────────────────────────────────────────────── */
	.kc-actions {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
		margin-top: var(--space-4);
	}
	.kc-generate {
		background: var(--kc-ink);
		color: var(--kc-field);
		border: 0;
		border-radius: 0;
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 600;
		padding: var(--space-3) var(--space-5);
		cursor: pointer;
		transition: opacity var(--dur-fast) var(--ease-out);
	}
	.kc-generate:hover { opacity: 0.85; }
	.kc-clear {
		background: none;
		border: 1px solid var(--kc-rule);
		border-radius: 0;
		color: var(--kc-dim);
		font: inherit;
		font-size: var(--text-sm);
		padding: var(--space-3) var(--space-4);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.kc-clear:hover { color: var(--kc-ink); border-color: var(--kc-ink); }
	.kc-note {
		margin-left: auto;
		color: var(--kc-dim);
		font-size: var(--text-xs);
	}

	/* ── Readout: the value is the hero ───────────────────────── */
	.kc-warn, .kc-nothing {
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		margin: var(--space-5) 0 0;
		max-width: 60ch;
	}
	.kc-warn { color: var(--kc-danger); font-weight: 600; }
	.kc-nothing { color: var(--kc-dim); }

	.kc-out {
		list-style: none;
		margin: var(--space-7) 0 0;
		padding: 0;
	}
	.kc-out li {
		border-top: 1px solid var(--kc-rule);
		animation: kc-wipe 320ms var(--ease-out) backwards;
		animation-delay: calc(var(--i, 0) * 70ms);
	}
	.kc-out li:last-child { border-bottom: 1px solid var(--kc-rule); }
	/* Prints in rather than fading in — it's a readout. */
	@keyframes kc-wipe {
		from { opacity: 0; clip-path: inset(0 100% 0 0); }
		to { opacity: 1; clip-path: inset(0 0 0 0); }
	}

	.kc-out-btn {
		width: 100%;
		display: block;
		background: none;
		border: 0;
		border-radius: 0;
		padding: var(--space-4) var(--space-3);
		text-align: left;
		cursor: pointer;
		font: inherit;
		color: inherit;
		transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}
	/* The committed idea: the row inverts under the pointer. */
	.kc-out-btn:hover, .kc-out-btn:focus-visible {
		background: var(--kc-ink);
		color: var(--kc-field);
		outline: none;
	}

	.kc-out-label {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--kc-dim);
		margin-bottom: var(--space-3);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.kc-out-btn:hover .kc-out-label,
	.kc-out-btn:focus-visible .kc-out-label { color: var(--kc-field); }
	.kc-out-copy { flex-shrink: 0; }

	.kc-out-value {
		display: block;
		font-family: var(--font-mono);
		font-size: clamp(1.125rem, 3.4vw, 2rem);
		line-height: 1.25;
		letter-spacing: -0.02em;
		word-break: break-all;
	}

	@media (max-width: 560px) {
		.kc-note { margin-left: 0; }
		.kc-field { gap: var(--space-3); }
	}

	@media (prefers-reduced-motion: reduce) {
		.kc-out li { animation: none; }
	}
</style>
