---
import Layout from '../layouts/Layout.astro';
import ToolsWorkspace from '../components/tools/ToolsWorkspace.tsx';

const { siteName, version } = Astro.locals;
const docs = Astro.locals.getDocsData();

// Real state from this server, not decoration: you are converting keys and
// hashing blobs *for this host*, so its wire addresses belong on the page.
const endpoints = [
	{ label: 'relay', value: docs.endpoints.relay },
	{ label: 'blossom', value: docs.endpoints.blossom },
	{ label: 'nip-96', value: docs.endpoints.nip96 },
	{ label: 'nip-05', value: docs.endpoints.nip05 },
].filter(e => e.value);
---
<Layout page="tools" width="wide">
	<header class="tools-head">
		<h1>Nostr tools</h1>
		<p class="tools-lede">
			Keys, events and blobs, handled entirely in this browser. Nothing you
			paste or pick is sent to <strong>{siteName}</strong> or anywhere else.
		</p>
	</header>

	<ToolsWorkspace client:load />

	<aside class="server" aria-labelledby="server-h">
		<h2 id="server-h">This server</h2>
		<div class="server-grid">
			{endpoints.length > 0 && (
				<div class="server-block">
					<h3>Wire addresses</h3>
					<dl class="server-list">
						{endpoints.map(e => (
							<div><dt>{e.label}</dt><dd><code>{e.value}</code></dd></div>
						))}
					</dl>
				</div>
			)}
			<div class="server-block">
				<h3>Implements</h3>
				<p class="server-counts">
					{docs.relayEnabled && <span><strong>{docs.nips.length}</strong>NIPs</span>}
					{docs.mediaEnabled && <span><strong>{docs.buds.length}</strong>BUDs</span>}
					{docs.lightningEnabled && <span><strong>{docs.luds.length}</strong>LUDs</span>}
					<span><strong>{docs.modules.length}</strong>modules</span>
				</p>
				<p class="server-note">
					Running nostrcheck-server <code>{version}</code>. The full list, with
					what each one does, is in the <a href="/documentation">documentation</a>.
				</p>
			</div>
		</div>
	</aside>
</Layout>

<style is:global>
	/* client:idle, not client:visible, on the three below-fold tools: Astro
	   renders every island as display:contents, so the element has a 0x0 box
	   and an IntersectionObserver on it never fires — the tools stayed
	   unhydrated and their controls did nothing. idle still defers the work
	   past first paint. Verified in the browser, not assumed.

	   Shared surface for every tool. Uses the system tokens rather than a
	   page-local palette: the visual direction is still being decided, and
	   these should follow it rather than fight it. */
	.tools-head { margin-bottom: var(--space-6); }
	.tools-head h1 { margin: 0 0 var(--space-3); }
	.tools-lede {
		color: var(--ink-muted);
		line-height: var(--leading-normal);
		max-width: 64ch;
		margin: 0;
	}
	.tools-lede strong { color: var(--ink); font-weight: 600; }

	/* ── Workspace: the rail picks, the pane works ────────────── */
	.ws {
		display: grid;
		grid-template-columns: 16rem 1fr;
		gap: var(--space-6);
		align-items: start;
		border-top: 1px solid var(--border);
		padding-top: var(--space-5);
	}
	.ws-rail ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
	.ws-tab {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0 var(--space-3);
		background: none;
		border: 0;
		border-radius: var(--radius-sm);
		padding: var(--space-3);
		text-align: left;
		cursor: pointer;
		font: inherit;
		color: var(--ink-muted);
		transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}
	.ws-tab:hover { background: var(--surface); color: var(--ink); }
	.ws-tab[aria-current="true"] { background: var(--surface-raised); color: var(--ink); }
	.ws-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
	.ws-tab-name { font-weight: 600; font-size: var(--text-sm); }
	.ws-tab-hint {
		grid-column: 1;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--ink-muted);
	}
	.ws-tab[aria-current="true"] .ws-tab-hint { color: var(--accent); }
	.ws-tab-key {
		/* explicit column, or auto-placement drops it in the first one and it
		   stretches across the tab pushing the name sideways */
		grid-column: 2;
		grid-row: 1 / span 2;
		align-self: center;
		justify-self: end;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--ink-muted);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0 var(--space-2);
	}

	.ws-pane { min-width: 0; }
	.ws-pane-head { margin-bottom: var(--space-5); }
	.ws-pane-head h2 { margin: 0 0 var(--space-2); }
	.ws-pane-head p {
		color: var(--ink-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		max-width: 62ch;
		margin: 0;
	}

	/* ── This server: real state, so the page isn't a lonely input ── */
	.server {
		margin-top: var(--space-8);
		border-top: 1px solid var(--border);
		padding-top: var(--space-5);
	}
	.server h2 {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-muted);
		font-weight: 600;
		margin: 0 0 var(--space-4);
	}
	.server-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
		gap: var(--space-6);
	}
	.server-block h3 { font-size: var(--text-sm); margin: 0 0 var(--space-3); }
	.server-list { margin: 0; }
	.server-list div {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: var(--space-3);
		align-items: baseline;
		padding: var(--space-2) 0;
		border-bottom: 1px solid var(--border-subtle);
		min-width: 0;
	}
	.server-list dt {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-muted);
	}
	.server-list dd { margin: 0; min-width: 0; }
	.server-list code {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		word-break: break-all;
		user-select: all;
	}
	.server-counts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		margin: 0 0 var(--space-3);
		font-size: var(--text-sm);
		color: var(--ink-muted);
	}
	.server-counts strong {
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--text-lg);
		margin-right: var(--space-2);
	}
	.server-note {
		color: var(--ink-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		max-width: 60ch;
		margin: 0;
	}
	.server-note code { font-family: var(--font-mono); font-size: var(--text-xs); }
	.server-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
	.server-note a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

	@media (max-width: 800px) {
		.ws { grid-template-columns: 1fr; gap: var(--space-5); }
		/* Rail becomes a row of tabs; the number hints go, there's no keyboard. */
		.ws-rail ul { flex-direction: row; overflow-x: auto; gap: var(--space-2); padding-bottom: var(--space-2); }
		.ws-tab { width: auto; white-space: nowrap; border: 1px solid var(--border); }
		.ws-tab-hint, .ws-tab-key { display: none; }
	}

	.tool-label {
		display: block;
		font-size: var(--text-sm);
		color: var(--ink-muted);
		margin-bottom: var(--space-2);
	}

	.tool-field {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: var(--space-3) var(--space-4);
		transition: border-color var(--dur-fast) var(--ease-out);
	}
	.tool-field:focus-within { border-color: var(--accent); }
	.tool-field[data-tone="danger"] { border-color: var(--danger); }
	.tool-input {
		flex: 1;
		min-width: 0;
		background: none;
		border: 0;
		padding: 0;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: var(--text-base);
	}
	.tool-input:focus { outline: none; }
	.tool-input::placeholder { color: var(--ink-muted); opacity: 1; font-size: var(--text-sm); }
	.tool-tag {
		flex-shrink: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
	}
	.tool-tag[data-tone="danger"] { color: var(--danger); }

	.tool-textarea {
		width: 100%;
		background: var(--surface);
		color: var(--ink);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: var(--space-3) var(--space-4);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		resize: vertical;
	}
	.tool-textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; border-color: var(--accent); }
	.tool-textarea::placeholder { color: var(--ink-muted); opacity: 1; }

	.tool-file {
		max-width: 100%;
		font-family: var(--font-ui);
		font-size: var(--text-sm);
		color: var(--ink-muted);
	}
	.tool-file::file-selector-button {
		font: inherit;
		font-weight: 600;
		color: var(--bg);
		background: var(--accent);
		border: 0;
		border-radius: var(--radius-sm);
		padding: var(--space-2) var(--space-4);
		margin-right: var(--space-3);
		cursor: pointer;
	}

	.tool-actions { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
	.tool-primary {
		background: var(--accent);
		color: var(--bg);
		border: 0;
		border-radius: var(--radius-sm);
		font: inherit;
		font-weight: 600;
		padding: var(--space-3) var(--space-5);
		cursor: pointer;
		transition: filter var(--dur-fast) var(--ease-out);
	}
	.tool-primary:hover { filter: brightness(1.1); }
	.tool-secondary {
		background: none;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--ink-muted);
		font: inherit;
		padding: var(--space-3) var(--space-4);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.tool-secondary:hover { color: var(--ink); border-color: var(--ink-muted); }
	.tool-primary:focus-visible, .tool-secondary:focus-visible,
	.tool-file:focus-visible, .tool-row-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.tool-warn {
		color: var(--danger);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		max-width: 62ch;
		margin: var(--space-4) 0 0;
	}
	.tool-muted {
		color: var(--ink-muted);
		font-size: var(--text-sm);
		margin: var(--space-4) 0 0;
	}

	/* ── Readout rows ─────────────────────────────────────────── */
	.tool-out { list-style: none; margin: var(--space-5) 0 0; padding: 0; }
	.tool-row { border-top: 1px solid var(--border); }
	.tool-row:last-child { border-bottom: 1px solid var(--border); }
	.tool-row-btn {
		width: 100%;
		display: block;
		background: none;
		border: 0;
		border-radius: 0;
		padding: var(--space-3);
		text-align: left;
		cursor: pointer;
		font: inherit;
		color: inherit;
		transition: background var(--dur-fast) var(--ease-out);
	}
	.tool-row-btn:hover { background: var(--surface); }
	.tool-row-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-muted);
		margin-bottom: var(--space-2);
	}
	.tool-row-label[data-tone="danger"] { color: var(--danger); }
	.tool-row-copy { flex-shrink: 0; }
	.tool-row-value {
		display: block;
		font-family: var(--font-mono);
		font-size: var(--text-base);
		line-height: 1.4;
		word-break: break-all;
	}

	/* ── Verifier ─────────────────────────────────────────────── */
	.tool-checks { list-style: none; margin: var(--space-5) 0 0; padding: 0; }
	.tool-checks li {
		display: flex;
		gap: var(--space-3);
		align-items: baseline;
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		margin-bottom: var(--space-2);
	}
	.tool-check-mark { font-weight: 700; flex-shrink: 0; }
	.tool-checks li[data-ok="true"] .tool-check-mark { color: var(--success); }
	.tool-checks li[data-ok="false"] .tool-check-mark { color: var(--danger); }

	.tool-facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-6);
		margin: var(--space-5) 0 0;
		font-size: var(--text-sm);
	}
	/* min-width:0 or the flex item refuses to shrink below its content and the
	   npub pushes the page sideways — break-all never gets a chance to fire. */
	.tool-facts div { display: flex; gap: var(--space-2); align-items: baseline; min-width: 0; }
	.tool-facts dd { min-width: 0; }
	.tool-facts dt { color: var(--ink-muted); }
	.tool-facts dd { margin: 0; }
	.tool-facts code { font-family: var(--font-mono); font-size: var(--text-xs); word-break: break-all; }
</style>
