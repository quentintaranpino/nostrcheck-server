---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';

// `page` pulls the SEO the operator set in settings (title/description/
// noindex/socialImage, per tenant); explicit props still override it.
interface Props { page?: string; title?: string; description?: string; image?: string; noindex?: boolean; width?: 'default' | 'wide' | 'bleed'; }
const props = Astro.props;
const { siteName, version, loggedIn, isAdmin, modules } = Astro.locals;
const seo = props.page && Astro.locals.getSeo ? Astro.locals.getSeo(props.page) : null;

const title = props.title ?? (seo?.title || siteName);
const description = props.description ?? (seo?.description || 'Self-hosted Nostr infrastructure');
const noindex = props.noindex ?? seo?.noindex ?? false;
const canonical = Astro.url.origin + Astro.url.pathname;
const ogImage = new URL(props.image ?? (seo?.socialImage || '/static/resources/logo-server.webp'), Astro.url).href;

// Public nav, gated by the same modules the EJS navbar checks. `active`
// matches the current page key so the item marks itself current.
const current = props.page;
const navItems = [
	{ label: 'Gallery', href: '/gallery', page: 'gallery', on: modules.media },
	{ label: 'Upload', href: '/media', page: 'cdn', on: modules.media },
	{ label: 'Directory', href: '/directory', page: 'directory', on: modules.register },
	{ label: 'Relay', href: '/relay', page: 'relay', on: modules.relay },
	{ label: 'Docs', href: '/documentation', page: 'docs', on: true },
	{ label: 'Tools', href: '/tools', page: 'tools', on: true },
].filter(i => i.on);
// One logo per theme, swapped by CSS. The server always answers with a
// default when the tenant uploaded none, and if it ever 404s the alt text
// stands in as the wordmark.
const logoLight = '/static/resources/appearance-server-logo-light.png';
const logoDark = '/static/resources/appearance-server-logo-dark.png';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- These two hex values mirror --bg per theme; check-contrast.mjs
		     fails the build if they drift from the tokens. -->
		<meta name="theme-color" content="#0c0912" id="theme-color" />
		<!-- Before any stylesheet: honours the same localStorage key the EJS
		     pages write, so switching between both frontends doesn't flash. -->
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem('theme');
					var dark = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
					document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
					if (!dark) document.getElementById('theme-color').setAttribute('content', '#fcfbfe');
				} catch (e) { /* private mode: dark stays */ }
			})();
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonical} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>
		<!-- The bar spans, its contents sit on the same column as the page. -->
		<header class="nav" id="site-nav" data-width={props.width ?? 'default'}>
			<div class="nav-inner">
			<a href="/" class="nav-brand">
				<img class="nav-logo nav-logo-light" src={logoLight} alt={siteName} width="82" height="28" />
				<img class="nav-logo nav-logo-dark" src={logoDark} alt={siteName} width="82" height="28" />
			</a>

			<nav class="nav-links" aria-label="Primary">
				{navItems.map(i => (
					<a href={i.href} class="nav-link" aria-current={current === i.page ? 'page' : undefined}>{i.label}</a>
				))}
			</nav>

			<div class="nav-actions">
				<button type="button" id="theme-toggle" class="nav-icon" aria-pressed="false" aria-label="Dark theme">
					<svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
					<svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
				</button>

				<a href="/directory" class="nav-search" aria-label="Search">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
					<kbd>⌘K</kbd>
				</a>

				{!loggedIn && (
					<>
						<a href="/login" class="nav-link">Login</a>
						{modules.register && <a href="/register" class="nav-cta">Register</a>}
					</>
				)}

				{loggedIn && (
					<details class="nav-acct">
						<summary aria-label="Account">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg>
						</summary>
						<div class="nav-menu">
							<a href="/profile">Profile</a>
							{isAdmin && <a href="/dashboard">Dashboard</a>}
							{isAdmin && <a href="/settings">Settings</a>}
							<a href="/api/v2/logout" data-logout>Log out</a>
						</div>
					</details>
				)}

				<details class="nav-burger">
					<summary aria-label="Menu">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
					</summary>
					<div class="nav-menu">
						{navItems.map(i => <a href={i.href} aria-current={current === i.page ? 'page' : undefined}>{i.label}</a>)}
						<div class="nav-menu-sep"></div>
						{!loggedIn && <a href="/login">Login</a>}
						{!loggedIn && modules.register && <a href="/register">Register</a>}
						{loggedIn && <a href="/profile">Profile</a>}
						{loggedIn && isAdmin && <a href="/dashboard">Dashboard</a>}
						{loggedIn && isAdmin && <a href="/settings">Settings</a>}
						{loggedIn && <a href="/api/v2/logout" data-logout>Log out</a>}
					</div>
				</details>
			</div>
			</div>
		</header>

		<main id="main" data-width={props.width ?? 'default'}><slot /></main>

		<footer class="foot" data-width={props.width ?? 'default'}>
			<div class="foot-inner">
				{version && <span class="foot-ver">v{version}</span>}
				<a href="https://github.com/quentintaranpino/nostrcheck-server/">source</a>
				<span class="foot-sep">·</span>
				<a href="/privacy">Privacy</a>
				<a href="/legal">Legal</a>
				<a href="/tos">Terms</a>
				<span class="foot-lic">MIT</span>
			</div>
		</footer>

		<script>
			// Hairline appears once the content scrolls under the bar.
			const nav = document.getElementById('site-nav');
			const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 4);
			onScroll();
			addEventListener('scroll', onScroll, { passive: true });

			// Theme toggle writes the same key the EJS toggle uses.
			const themeBtn = document.getElementById('theme-toggle');
			const paintTheme = (theme) => {
				document.documentElement.setAttribute('data-bs-theme', theme);
				document.getElementById('theme-color')?.setAttribute('content', theme === 'dark' ? '#0c0912' : '#fcfbfe');
				// The label names the current theme so the control has state.
				themeBtn?.setAttribute('aria-pressed', String(theme === 'dark'));
				themeBtn?.setAttribute('aria-label', theme === 'dark' ? 'Dark theme, switch to light' : 'Light theme, switch to dark');
			};
			paintTheme(document.documentElement.getAttribute('data-bs-theme'));
			themeBtn?.addEventListener('click', () => {
				const next = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
				paintTheme(next);
				try { localStorage.setItem('theme', next); } catch (e) { /* private mode */ }
			});

			// Follow the OS while the user hasn't picked a side, same as EJS.
			matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
				let saved = null;
				try { saved = localStorage.getItem('theme'); } catch (err) { /* private mode */ }
				if (saved === 'dark' || saved === 'light') return;
				paintTheme(e.matches ? 'dark' : 'light');
			});

			// Native <details> doesn't light-dismiss; give it outside-click and Escape.
			const menus = [...document.querySelectorAll('.nav-acct, .nav-burger')];
			document.addEventListener('click', e => {
				menus.forEach(d => { if (d.open && !d.contains(e.target)) d.open = false; });
			});
			document.addEventListener('keydown', e => {
				if (e.key !== 'Escape') return;
				menus.forEach(d => {
					if (!d.open) return;
					d.open = false;
					d.querySelector('summary')?.focus();
				});
			});

			// The ⌘K hint has to be true: same keys the EJS pages bind.
			addEventListener('keydown', e => {
				const inField = e.target instanceof Element && e.target.closest('input, textarea, [contenteditable="true"]');
				const cmdK = (e.key === 'k' || e.key === 'K') && (e.ctrlKey || e.metaKey);
				const slash = e.key === '/' && !inField && !e.ctrlKey && !e.metaKey && !e.altKey;
				if (!cmdK && !slash) return;
				e.preventDefault();
				document.querySelector('.nav-search')?.click();
			});

			// The endpoint kills the session, but the cached profile lives in
			// localStorage — drop it too or the EJS pages keep the old avatar.
			document.querySelectorAll('[data-logout]').forEach(a => {
				a.addEventListener('click', () => {
					try { localStorage.removeItem('profileData'); } catch (e) { /* private mode */ }
				});
			});
		</script>
	</body>
</html>

<style>
	/* One visible focus treatment for every control in the chrome: colour
	   alone was ~1.9:1 against the rest state and identical to hover. */
	.skip-link:focus,
	.nav-link:focus-visible,
	.nav-search:focus-visible,
	.nav-cta:focus-visible,
	.nav-icon:focus-visible,
	.nav-menu a:focus-visible,
	.foot a:focus-visible,
	.nav-acct summary:focus-visible,
	.nav-burger summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.skip-link {
		position: absolute;
		left: var(--space-3);
		top: var(--space-3);
		z-index: var(--z-toast);
		padding: var(--space-2) var(--space-3);
		background: var(--surface-raised);
		color: var(--ink);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-size: var(--text-sm);
		text-decoration: none;
		transform: translateY(-200%);
	}
	.skip-link:focus { transform: none; }

	.nav {
		position: sticky;
		top: 0;
		z-index: var(--z-sticky);
		height: 52px;
		background: color-mix(in oklch, var(--bg) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid transparent;
		transition: border-color var(--dur-base) var(--ease-out);
	}
	.nav.scrolled { border-bottom-color: var(--border-subtle); }

	/* Mirrors main's column exactly, per width mode, so the logo lines up with
	   the h1 and the account menu with the content's right edge. */
	.nav-inner, .foot-inner {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		height: 100%;
		width: 100%;
		max-width: 48rem;
		margin-inline: auto;
		padding-inline: var(--space-5);
	}
	.nav[data-width="wide"] .nav-inner, .foot[data-width="wide"] .foot-inner { max-width: 68rem; }
	.nav[data-width="bleed"] .nav-inner, .foot[data-width="bleed"] .foot-inner { max-width: none; }

	.nav-brand { display: inline-flex; align-items: center; flex-shrink: 0; }
	.nav-logo { display: block; width: auto; }
	.nav-logo-dark { display: none; }
	:global(html[data-bs-theme="dark"]) .nav-logo-light { display: none; }
	:global(html[data-bs-theme="dark"]) .nav-logo-dark { display: block; }

	/* Icon buttons in the bar: theme toggle, account, burger. */
	.nav-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: 0;
		padding: var(--space-1);
		color: var(--ink-muted);
		cursor: pointer;
		border-radius: var(--radius-sm);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.nav-icon:hover, .nav-icon:focus-visible { color: var(--ink); outline: none; }
	.icon-moon { display: none; }
	:global(html[data-bs-theme="dark"]) .icon-sun { display: none; }
	:global(html[data-bs-theme="dark"]) .icon-moon { display: block; }

	.nav-links { display: flex; align-items: center; gap: var(--space-1); margin-right: auto; }
	.nav-link {
		color: var(--ink-muted);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: 500;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
	}
	.nav-link:hover, .nav-link:focus-visible { color: var(--ink); outline: none; }
	.nav-link[aria-current="page"] { color: var(--ink); background: var(--surface); }

	.nav-actions { display: flex; align-items: center; gap: var(--space-3); flex-shrink: 0; }

	.nav-search {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--ink-muted);
		text-decoration: none;
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.nav-search:hover, .nav-search:focus-visible { color: var(--ink); border-color: var(--ink-muted); outline: none; }
	.nav-search kbd {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--ink-muted);
	}

	.nav-cta {
		color: var(--bg);
		background: var(--accent);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: 600;
		padding: var(--space-1) var(--space-4);
		border-radius: var(--radius-sm);
		transition: filter var(--dur-fast) var(--ease-out);
	}
	.nav-cta:hover, .nav-cta:focus-visible { filter: brightness(1.1); outline: none; }

	/* Account + burger share the same native <details> dropdown. */
	.nav-acct, .nav-burger { position: relative; }
	.nav-acct summary, .nav-burger summary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--ink-muted);
		cursor: pointer;
		list-style: none;
		padding: var(--space-1);
		border-radius: var(--radius-sm);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.nav-acct summary::-webkit-details-marker, .nav-burger summary::-webkit-details-marker { display: none; }
	.nav-acct summary:hover, .nav-burger summary:hover { color: var(--ink); }
	.nav-menu {
		position: absolute;
		right: 0;
		top: calc(100% + var(--space-2));
		display: flex;
		flex-direction: column;
		min-width: 168px;
		padding: var(--space-2);
		background: var(--surface-raised);
		/* The shadow and the raised fill already say 'panel'; a 3:1 stroke on
		   top of them just makes it heavy. */
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-menu);
	}
	.nav-menu a {
		color: var(--ink-muted);
		text-decoration: none;
		font-size: var(--text-sm);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-sm);
		transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
	}
	.nav-menu a:hover, .nav-menu a:focus-visible { color: var(--ink); background: var(--bg); outline: none; }
	/* Logging out isn't destructive — --danger belongs to the nsec warning,
	   and sharing it here would dull the signal where it matters. */
	.nav-menu-sep { height: 1px; background: var(--border-subtle); margin: var(--space-2) 0; }

	.nav-burger { display: none; }

	/* Footer sits at the bottom without hardcoding the chrome heights. */
	body { display: flex; flex-direction: column; min-height: 100vh; }
	main {
		flex: 1;
		width: 100%;
		max-width: 48rem;
		margin: 0 auto;
		padding: var(--space-6) var(--space-5) var(--space-8);
	}
	/* Reference pages with tables need more room than a reading column. */
	main[data-width="wide"] { max-width: 68rem; }
	/* Full-bleed: the page owns the width and its own inner column. Done here
	   rather than with 100vw margins in the page — those overflow by the width
	   of the vertical scrollbar. */
	main[data-width="bleed"] { max-width: none; padding: 0; }
	@media (max-width: 480px) {
		main { padding-inline: var(--space-4); }
	}

	.foot {
		padding-block: var(--space-5);
		font-size: var(--text-sm);
		color: var(--ink-muted);
	}
	.foot-inner { gap: var(--space-3); flex-wrap: wrap; height: auto; }
	/* padding, not bare text: the links were ~20px tall, under the 24px floor */
	.foot a {
		color: var(--ink-muted);
		text-decoration: none;
		padding: var(--space-2) var(--space-1);
		border-radius: var(--radius-sm);
		transition: color var(--dur-fast) var(--ease-out);
	}
	.foot a:hover, .foot a:focus-visible { color: var(--ink); outline: none; }
	.foot-ver { font-family: var(--font-mono); font-size: var(--text-xs); }
	.foot-lic { margin-left: auto; font-family: var(--font-mono); font-size: var(--text-xs); }
	.foot-sep { opacity: 0.5; }

	/* Tablet and small laptops: the whole row (6 links + search + both auth
	   actions) needs ~950px, so drop the search widget before it collides. */
	@media (max-width: 960px) {
		.nav-search { display: none; }
		.nav { gap: var(--space-4); }
	}

	/* Mobile: links and account fold into the burger. Register stays in the
	   bar — it's the primary action and doesn't belong behind a menu. Login
	   goes: it's already in the burger and the bar can't fit both at 320px. */
	@media (max-width: 720px) {
		.nav-links, .nav-acct, .nav-actions > .nav-link { display: none; }
		.nav-actions { margin-left: auto; }
		.nav-burger { display: block; }
		/* Comfortable thumb targets once there's no mouse. */
		.nav-icon, .nav-burger summary { min-width: 44px; min-height: 44px; }
		.nav-cta { padding-block: var(--space-2); }
	}

	@media (prefers-reduced-motion: reduce) {
		.nav, .nav-link, .nav-search, .nav-cta, .nav-menu a, .foot a { transition: none; }
	}
</style>
