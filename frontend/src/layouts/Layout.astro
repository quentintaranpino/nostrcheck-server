---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';

// `page` pulls the SEO the operator set in settings (title/description/
// noindex/socialImage, per tenant); explicit props still override it.
interface Props { page?: string; title?: string; description?: string; image?: string; noindex?: boolean; }
const props = Astro.props;
const host = Astro.locals.host ?? Astro.url.hostname;
const seo = props.page && Astro.locals.getSeo ? Astro.locals.getSeo(props.page) : null;

const siteName = seo?.siteName || host;
const title = props.title ?? (seo?.title || siteName);
const description = props.description ?? (seo?.description || 'Self-hosted Nostr infrastructure');
const noindex = props.noindex ?? seo?.noindex ?? false;
// canonical + og:url without the query string; images absolute for scrapers
const canonical = Astro.url.origin + Astro.url.pathname;
const ogImage = new URL(props.image ?? (seo?.socialImage || '/static/resources/logo-server.webp'), Astro.url).href;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16121f" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,nofollow" />}
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonical} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="site-header-brand">{siteName}</a>
		</header>
		<main><slot /></main>
		<footer class="site-footer">
			<a href="https://github.com/quentintaranpino/nostrcheck-server/">source</a>
		</footer>
	</body>
</html>

<style>
	.site-header { padding: var(--space-4) var(--space-5); }
	.site-header-brand {
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: var(--space-6) var(--space-5) var(--space-8);
	}
	.site-footer {
		padding: var(--space-5);
		text-align: center;
	}
	.site-footer a { color: var(--ink-muted); }
</style>
